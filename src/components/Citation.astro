---
interface Props {
  author?: string;
  note?: string;        // mention de traduction (epi-tradfr)
  hr?: boolean;         // affiche la barre horizontale (défaut: true)
  extraPad?: boolean;   // padding-bottom majoré pour blocs adjacents (2.8rem)
}

const { author, note, hr = true, extraPad = false } = Astro.props;
const hasShort = Astro.slots.has('short');
---

<div class:list={['epi-wrap', { 'epi-wrap--hr': hr, 'epi-wrap--extra-pad': extraPad }]}>
  {hasShort ? (
    <>
      <blockquote class="bq-long"><slot /></blockquote>
      <blockquote class="bq-short"><slot name="short" /></blockquote>
    </>
  ) : (
    <blockquote><slot /></blockquote>
  )}
  {author && (
    <cite>
      {author}
      {note && <span class="epi-tradfr">{note}</span>}
    </cite>
  )}
</div>

<style is:global>
  .epi-wrap {
    border-left: 1px solid var(--brume);
    padding: .2rem 0 1.8rem 1.3rem;
    max-width: 60ch;
  }

  .epi-wrap--extra-pad { padding-bottom: 2.8rem; }

  .epi-wrap--hr { padding-bottom: 0; }
  .epi-wrap--hr::after {
    content: '';
    display: block;
    width: var(--horizon-width, 64px);
    height: var(--horizon-height, 1.5px);
    background: var(--brume);
    margin-top: 1.8rem;
    margin-left: calc(-1.3rem - 1px);
  }

  .epi-wrap blockquote {
    font-family: var(--font-body);
    font-weight: 300;
    font-style: italic;
    font-size: var(--t-m);
    line-height: 1.85;
    color: var(--ardoise);
  }

  .k { font-weight: inherit; }

  .epi-wrap cite {
    display: block;
    margin-top: .9rem;
    font-style: normal;
    font-size: var(--t-xs);
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--cerule);
  }

  .epi-tradfr {
    display: block;
    font-size: var(--t-xs);
    letter-spacing: .08em;
    text-transform: none;
    font-style: italic;
    color: var(--ardoise);
    margin-top: .2rem;
  }

  /* Variante longue/courte : long visible desktop, court visible mobile */
  .bq-short { display: none; }
  @media (max-width: 700px) {
    .bq-long { display: none; }
    .bq-short { display: block; }
  }
</style>
