---
interface Props {
  author?: string;
  note?: string;
  extraPad?: boolean;
}

const { author, note, extraPad = false } = Astro.props;

// Split "Author Name · Work Title" so neither segment breaks internally.
// The interpunct is the only allowed break-point between them.
const authorParts = author ? author.split(' · ') : [];
---

<div class:list={['epi-wrap', { 'epi-wrap--extra-pad': extraPad }]}>
  <blockquote><slot /></blockquote>
  {author && (
    <cite>
      {authorParts.map((part, i) => (
        <>
          {i > 0 && ' · '}
          <span class="epi-nowrap">{part}</span>
        </>
      ))}
      {note && <span class="epi-tradfr">{note}</span>}
    </cite>
  )}
</div>

<style is:global>
  .epi-wrap {
    border-left: 1px solid var(--brume);
    padding: .2rem 0 1.8rem 1.3rem;
    max-width: 60ch;
  }

  .epi-wrap--extra-pad { padding-bottom: 2.8rem; }

  .epi-wrap blockquote {
    font-family: var(--font-body);
    font-weight: 300;
    font-style: italic;
    font-size: var(--t-m);
    line-height: 1.85;
    color: var(--ardoise);
  }

  .epi-wrap cite {
    display: block;
    margin-top: .9rem;
    font-style: normal;
    font-size: var(--t-xs);
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--cerule);
  }

  /* Règle système : le nom de l'auteur et le titre de l'œuvre ne se coupent
     jamais individuellement. Le seul point de rupture autorisé est le · qui
     les sépare. white-space: nowrap sur la ligne entière est interdit (débord
     horizontal à faible largeur). */
  .epi-nowrap {
    white-space: nowrap;
  }

  .epi-tradfr {
    display: block;
    font-size: var(--t-xs);
    letter-spacing: .08em;
    text-transform: none;
    font-style: italic;
    color: var(--ardoise);
    margin-top: .2rem;
  }
</style>
