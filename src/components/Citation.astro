---
interface Props {
  author?: string;
  note?: string;
  extraPad?: boolean;
}

const { author, note, extraPad = false } = Astro.props;
const hasShort = Astro.slots.has('short');
---

<div class:list={['epi-wrap', { 'epi-wrap--extra-pad': extraPad }]}>
  {hasShort ? (
    <>
      <blockquote class="bq-long"><slot /></blockquote>
      <blockquote class="bq-short"><slot name="short" /></blockquote>
    </>
  ) : (
    <blockquote><slot /></blockquote>
  )}
  {author && (
    <cite>
      {author}
      {note && <span class="epi-tradfr">{note}</span>}
    </cite>
  )}
</div>

<style is:global>
  .epi-wrap {
    border-left: 1px solid var(--brume);
    padding: .2rem 0 1.8rem 1.3rem;
    max-width: 60ch;
  }

  .epi-wrap--extra-pad { padding-bottom: 2.8rem; }

  .epi-wrap blockquote {
    font-family: var(--font-body);
    font-weight: 300;
    font-style: italic;
    font-size: var(--t-m);
    line-height: 1.85;
    color: var(--ardoise);
  }

  .epi-wrap cite {
    display: block;
    margin-top: .9rem;
    font-style: normal;
    font-size: var(--t-xs);
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--cerule);
  }

  .epi-tradfr {
    display: block;
    font-size: var(--t-xs);
    letter-spacing: .08em;
    text-transform: none;
    font-style: italic;
    color: var(--ardoise);
    margin-top: .2rem;
  }

  /* Variante longue/courte : long visible desktop, court visible mobile */
  .bq-short { display: none; }
  @media (max-width: 700px) {
    .bq-long { display: none; }
    .bq-short { display: block; }
  }
</style>
