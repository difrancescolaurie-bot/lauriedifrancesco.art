---
interface Props {
  author?: string;
  note?: string;        // note secondaire en petit italique (ex: "free translation from the French")
  justify?: boolean;    // text-align: justify sur le blockquote
  hr?: boolean;         // affiche le trait horizontal (défaut: true)
}

const { author, note, justify = false, hr = true } = Astro.props;
---

<div class:list={['epi-wrap', { 'epi-wrap--hr': hr }]}>
  <blockquote class:list={[{ 'epi-justify': justify }]}>
    <slot />
  </blockquote>
  {author && (
    <cite>
      {author}
      {note && <span class="epi-tradfr">{note}</span>}
    </cite>
  )}
</div>

<style is:global>
  .epi-wrap {
    border-left: 2px solid var(--cerule);
    padding: .2rem 0 1.8rem 1.3rem;
    max-width: 60ch;
  }

  /* Le trait horizontal est un ::after ancré dans l'élément :
     aucun margin externe sur .epi-wrap ne peut créer d'espace entre le
     border-left et le trait, garantissant qu'ils se rejoignent toujours. */
  .epi-wrap--hr {
    padding-bottom: 0;
  }
  .epi-wrap--hr::after {
    content: '';
    display: block;
    width: var(--horizon-width, 64px);
    height: var(--horizon-height, 1.5px);
    background: var(--cerule);
    margin-top: 1.8rem;
    /* aligne le trait avec le bord gauche du border-left */
    margin-left: calc(-1.3rem - 2px);
  }

  .epi-wrap blockquote {
    font-family: var(--font-title);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(.88rem, 1.2vw, 1rem);
    line-height: 1.55;
    color: var(--ardoise);
  }

  .epi-wrap blockquote.epi-justify {
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .k {
    color: var(--cerule);
    font-weight: 500;
  }

  .epi-wrap cite {
    display: block;
    margin-top: .9rem;
    font-style: normal;
    font-size: .7rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--cerule);
  }

  .epi-tradfr {
    display: block;
    font-size: .62rem;
    letter-spacing: .08em;
    text-transform: none;
    font-style: italic;
    color: var(--ardoise);
    margin-top: .2rem;
  }
</style>
