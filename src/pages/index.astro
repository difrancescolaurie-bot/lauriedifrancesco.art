---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/home.css';

const wipProjects = [
  {
    href: '/work/quando-sono-qui',
    title: 'Quando sono qui, non sono là',
    cerule: 'Resignifying',
    note: 'Being there means missing here. Or does it?',
    image: '/images/work/quando-cover.jpg',
  },
  {
    href: '/work/la-mer-en-corps',
    title: 'La Mer en Corps',
    cerule: 'Tracing',
    note: 'Water and dreams, giving body to movement.<br />A year of passages.',
    image: '/images/work/la-mer-en-corps-cover.jpg',
  },
];

const prevProjects = [
  {
    href: '/work/toward-the-blue',
    title: 'Toward the Blue',
    cerule: 'dreaming',
    note: 'Look up into the blue of the sky. Dream of a lightness lost.',
    image: '/images/work/toward-the-blue-cover.jpg',
  },
  {
    href: '/work/en-corps-en-la-mer',
    title: 'En Corps à la Mer',
    cerule: 'Surfacing',
    note: 'Learning to walk again, through water and through dreams.',
    image: '/images/work/en-corps-cover.jpg',
  },
];
---

<Layout
  title="Home"
  description="Documentary and poetic photography · Where the blue of the sky opens into new shades"
  lightHeader={false}
>

  <!-- ─── Hero ─────────────────────────────────────────────── -->
  <section class="hero" aria-label="Hero">

    <div class="hero-bg" aria-hidden="true">
      <img src="/images/hero/1_fixe-1-halo.jpg"     alt="sunlight through a cave opening"              loading="eager" fetchpriority="high" />
      <img src="/images/hero/2_fixe-2-garcon.jpg"    alt="a child swimming in still water"              loading="lazy" />
      <img src="/images/hero/matiere-roche.jpg"       alt="cave rock wall in red light"                  loading="lazy" class="hero-random" />
      <img src="/images/hero/4_fixe-3-gelsomina.jpg" alt="a silhouette reflected in a shop window"      loading="lazy" />
      <img src="/images/hero/matiere-oiseau.jpg"      alt="a bird in flight, motion blur"                loading="lazy" class="hero-random" />
      <img src="/images/hero/6_fixe-4-toward.jpg"    alt="a young woman's face through prismatic light" loading="lazy" />
      <img src="/images/hero/matiere-bananier.jpg"    alt="banana flower, close-up"                      loading="lazy" class="hero-random" />
      <img src="/images/hero/8_fixe-5-gisele.jpg"    alt="a woman floating in dark water"               loading="lazy" />
    </div>

    <div class="hero-inner container">
      <h1>
        Laurie<br />
        <span class="l2">Di Francesco</span>
      </h1>
      <hr class="horizon hero-horizon" />
      <p class="hero-tag">
        Documentary and poetic photography<br />
        <em>Where the blue of the sky opens into new shades</em>
      </p>
    </div>

  </section>

  <!-- ─── Manifeste trilingue ───────────────────────────────── -->
  <section class="creed container" aria-label="Manifesto">
    <div class="creed-lines">
      <p class="creed-it">Quando sono qui, non sono là.</p>
      <p class="creed-fr">Quand je suis ici, je ne suis pas là-bas.</p>
      <p class="creed-pt">Quando estou aqui, não estou lá.</p>
    </div>
  </section>

  <!-- ─── Aperçu des œuvres ─────────────────────────────────── -->
  <section class="works container" aria-label="Selected work">

    <p class="creed-eyebrow">Currently</p>

    {wipProjects.map(p => (
      <a class="work-item" href={p.href}>
        <div class="work-frame">
          <img src={p.image} alt={p.title} loading="lazy" />
        </div>
        <div class="work-meta">
          <span class="work-category">{p.cerule}</span>
          <h2 class="work-title">{p.title}</h2>
          <p class="work-note" set:html={p.note}></p>
          <span class="work-enter">Enter ↗</span>
        </div>
      </a>
    ))}

    <div class="works-divider">
      <hr class="works-divider-line" />
      <p class="works-divider-label">Previous works</p>
    </div>

    <div class="works-prev-grid">
      {prevProjects.map(p => (
        <a class="work-item work-item--prev" href={p.href}>
          <div class="work-frame">
            <img src={p.image} alt={p.title} loading="lazy" />
          </div>
          <div class="work-meta">
            <span class="work-category">{p.cerule}</span>
            <h2 class="work-title">{p.title}</h2>
            {p.note && <p class="work-note">{p.note}</p>}
          </div>
        </a>
      ))}
    </div>

    <div class="works-more">
      <a href="/work" class="works-more-link">View more →</a>
    </div>

  </section>

  <!-- ─── Bloc exposition ───────────────────────────────────── -->
  <section class="ex-home container" aria-label="Exhibition">
    <p class="ex-home-label">Solo exhibition</p>
    <h2 class="ex-home-title">Spilling Beyond the Lines</h2>
    <p class="ex-home-meta">
      Belo Horizonte, Brazil &middot; July 2024 &middot; Twenty-five photographs<br />
      Built around a single question: what a border truly separates.
    </p>
    <a class="ex-home-link" href="/exhibitions">See the exhibition &rarr;</a>
  </section>

</Layout>

<script is:inline>
(function () {
  var MATIERES = [
    { src: '/images/hero/matiere-roche.jpg',    pos: 'center center' },
    { src: '/images/hero/matiere-oiseau.jpg',   pos: 'center center' },
    { src: '/images/hero/matiere-bananier.jpg', pos: 'center center' },
    { src: '/images/hero/matiere-cheveux.jpg',  pos: 'center center' },
    { src: '/images/hero/matiere-falaises.jpg', pos: 'center center' },
    { src: '/images/hero/matiere-toboggan.jpg', pos: 'center center' },
  ];
  function shuffle(arr) {
    for (var i = arr.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
    }
    return arr;
  }
  function drawHero() {
    var slots = document.querySelectorAll('.hero-random');
    if (!slots.length) return;
    var drawn = shuffle(MATIERES.slice()).slice(0, slots.length);
    slots.forEach(function(slot, i) {
      slot.src = drawn[i].src;
      slot.style.objectPosition = drawn[i].pos;
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', drawHero);
  } else {
    drawHero();
  }
})();
</script>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          observer.unobserve(e.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('.work-item').forEach(el => observer.observe(el));
</script>
