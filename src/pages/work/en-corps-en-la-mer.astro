---
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/work-project.css';
import Citation from '../../components/Citation.astro';
import NextProject from '../../components/NextProject.astro';

const s = (file: string) => `/images/work/en-corps-en-la-mer/${file}`;

type Photo = { src: string; n: number };
type Spread = {
  type: 'row' | 'single';
  photos: Photo[];
  caption?: string;
};

const p = (n: number): Photo => ({ src: s(`${n}.jpg`), n });

const spreads: Spread[] = [
  // La chute — intérieur, maladie
  { type: 'row',    photos: [p(53), p(56)] },
  // Les seuils — fenêtres, attente
  { type: 'row',    photos: [p(55), p(59)] },
  // Vers l'eau — la mer apparaît
  { type: 'row',    photos: [p(57), p(58), p(60), p(61)] },
  { type: 'single', photos: [p(62)] },
  // L'immersion — le corps dans l'eau
  { type: 'row',    photos: [p(64), p(65), p(67)] },
  // Les signes — flottements, objets, le flamant
  { type: 'row',    photos: [p(66), p(70), p(71), p(72)] },
  { type: 'row',    photos: [p(73), p(74)] },
  // Refaire surface — vers la blancheur
  { type: 'row',    photos: [p(69), p(76)] },
];
---

<Layout
  title="En Corps à la Mer · Laurie Di Francesco"
  description="En Corps à la Mer · Surfacing · 2025. A photographic series by Laurie Di Francesco."
  image="/images/work/en-corps-cover.jpg"
  bodyClass="page-ecm"
  lightHeader={false}
>

  <!-- ── Hero ──────────────────────────────────────────────── -->
  <section class="phero">
    <div class="phero-bg" aria-hidden="true">
      <img src="/images/work/en-corps-en-la-mer/72.jpg" alt="" loading="eager" />
    </div>
    <div class="phero-inner container">
      <p class="phero-eyebrow">Surfacing</p>
      <h1>En Corps<br /><strong>à la Mer</strong></h1>
    </div>
  </section>

  <!-- ── Ouverture : deux rangées photo + citation ── -->
  <section class="gal-opening">

    <div class="gal-row rv">
      <figure class="gal-cell gal-cell--photo">
        <img src={s('51.jpg')} alt="" loading="lazy" data-no-lightbox />
      </figure>
      <div class="gal-cell gal-cell--cit">
        <Citation author="Friedrich Nietzsche · Posthumous Fragments">
          That fundamental artistic phenomenon which is called life
        </Citation>
      </div>
    </div>

    <div class="gal-row rv">
      <div class="gal-cell gal-cell--cit">
        <Citation author="Claire Marin · Hors de moi" note="freely translated from the French">
          Dreams and water are two worlds where I recover a little balance, a little lightness,
          where I live again the pleasure of movement. Held within the water's sheath, my body
          lets go of its pain. It fades, dissolves, vanishes. My movements turn fluid, easy;
          my body supple, almost deft. Gone, the tender catching-points: the hips, the elbows —
          nothing rasps anymore, nothing chafes, nothing tears. I remember dreaming I was a mermaid.
          My legs were imprisoned in a cocoon formed by the sheets, wound tight from turning and
          turning on myself in search of a position without pain. In the dream, the mummification
          had been transfigured into a power of movement.
        </Citation>
      </div>
      <figure class="gal-cell gal-cell--photo">
        <img src={s('52.jpg')} alt="" loading="lazy" data-no-lightbox />
      </figure>
    </div>

  </section>

  <!-- ── Texte du projet ──────────────────────────────────── -->
  <div class="ecm-text">
    <p class="opening-eyebrow">The project</p>
    <p class="opening-text">
      There was a season when the body gave way, when illness pulled the ground
      from under everything and strength drained off like a tide going out. <em>En Corps à la Mer</em> follows that long descent and its turning:
      force returning not through stillness, but through water. To swim was to
      be carried and to carry oneself at once. To surface, and surface again,
      until surfacing became a way of living. The series moves from dark
      interiors toward an open, dazzling white: the sea as the place where a
      life is handed back.
    </p>
    <hr class="horizon opening-horizon" />
  </div>

  <!-- ── Série photographique ──────────────────────────────── -->
  <div class="series">
    {spreads.map((spread) => (
      <>
        <div class={`spread spread--${spread.type} rv`}>
          {spread.photos.map((photo) => (
            <figure>
              <img
                src={photo.src}
                alt={`En Corps à la Mer · ${photo.n}`}
                loading="lazy"
                data-no-lightbox
              />
            </figure>
          ))}
        </div>
        {spread.caption && (
          <p class="series-caption rv">{spread.caption}</p>
        )}
      </>
    ))}
  </div>

  <!-- ── Accès galerie privée ─────────────────────────────── -->
  <div class="private-link container">
    <a href="/work/en-corps-en-la-mer/private">Complete series (private access) →</a>
  </div>

  <!-- ── Crédits ─────────────────────────────────────────── -->
  <div class="project-credits">
    <div class="group">
      <div class="label">With thanks</div>
      <p>With thanks to Jérôme Gaudin and Boriana Goranova for their friendship, to Lucie Lejeune for her support, and to Antoine d'Agata for his eye and his kindness.</p>
    </div>
  </div>

  <!-- ── Projet suivant ─────────────────────────────────────── -->
  <NextProject current="en-corps-en-la-mer" />

</Layout>


<script>
  // Justified row layout
  function justify() {
    const mob = window.innerWidth <= 700;
    document.querySelectorAll<HTMLElement>('.spread--row').forEach(row => {
      const figs = Array.from(row.querySelectorAll<HTMLElement>('figure'));
      const imgs = figs.map(f => f.querySelector<HTMLImageElement>('img')!);
      const getR = (im: HTMLImageElement) =>
        (im.naturalWidth && im.naturalHeight) ? im.naturalWidth / im.naturalHeight : 1;
      function apply() {
        if (mob && figs.length === 3) {
          figs[0].style.flex = `${getR(imgs[0]).toFixed(4)} 1 0`;
          figs[1].style.flex = `${getR(imgs[1]).toFixed(4)} 1 0`;
          figs[2].style.flex = '0 0 100%';
          return;
        }
        if (mob && figs.length === 4) {
          const avail = row.clientWidth - 8;
          ([[0,1],[2,3]] as [number,number][]).forEach(([a,b]) => {
            const ra = getR(imgs[a]), rb = getR(imgs[b]);
            const wa = Math.round(ra / (ra + rb) * avail);
            figs[a].style.flex = `0 0 ${wa}px`;
            figs[b].style.flex = `0 0 ${avail - wa}px`;
          });
          return;
        }
        imgs.forEach((im, i) => {
          figs[i].style.flex = '';
          figs[i].style.flexGrow = getR(im).toFixed(4);
        });
      }
      if (imgs.every(im => im.complete && im.naturalWidth)) apply();
      else imgs.forEach(im => im.addEventListener('load', apply));
    });
  }
  function layoutGalRows() {
    const mob = window.innerWidth <= 700;
    const H = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--rowh')) || 380;
    document.querySelectorAll<HTMLElement>('.gal-cell--photo').forEach(cell => {
      const img = cell.querySelector<HTMLImageElement>('img');
      if (!img) return;
      function apply() {
        if (mob) { cell.style.width = ''; return; }
        const r = img!.naturalWidth && img!.naturalHeight
          ? img!.naturalWidth / img!.naturalHeight : 1;
        cell.style.width = Math.round(r * H) + 'px';
      }
      if (img.complete && img.naturalWidth) apply();
      else img.addEventListener('load', apply);
    });
  }
  justify();
  layoutGalRows();
  window.addEventListener('resize', () => {
    clearTimeout((window as any)._jt);
    (window as any)._jt = setTimeout(() => { justify(); layoutGalRows(); }, 150);
  });

  // Scroll reveal
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
    });
  }, { threshold: .06 });
  document.querySelectorAll('.rv').forEach(el => obs.observe(el));

</script>
