---
import Layout from '../../layouts/Layout.astro';
import Citation from '../../components/Citation.astro';
import NextProject from '../../components/NextProject.astro';

const s = (file: string) => `/images/work/en-corps-en-la-mer/${file}`;

type Photo = { src: string; n: number };
type Spread = {
  type: 'row' | 'single';
  photos: Photo[];
  caption?: string;
};

const p = (n: number): Photo => ({ src: s(`${n}.jpg`), n });

const spreads: Spread[] = [
  // La chute — intérieur, maladie
  { type: 'row',    photos: [p(53), p(56)] },
  // Les seuils — fenêtres, attente
  { type: 'row',    photos: [p(55), p(59)] },
  // Vers l'eau — la mer apparaît
  { type: 'row',    photos: [p(57), p(58), p(60), p(61)] },
  { type: 'single', photos: [p(62)] },
  // L'immersion — le corps dans l'eau
  { type: 'row',    photos: [p(64), p(65), p(67)] },
  // Les signes — flottements, objets, le flamant
  { type: 'row',    photos: [p(66), p(70), p(71), p(72)] },
  { type: 'row',    photos: [p(73), p(74)] },
  // Refaire surface — vers la blancheur
  { type: 'row',    photos: [p(69), p(76)] },
];
---

<Layout
  title="En Corps à la Mer — Laurie Di Francesco"
  description="En Corps à la Mer — Surfacing · 2025. A photographic series by Laurie Di Francesco."
  image="/images/work/en-corps-cover.jpg"
>

  <!-- ── Hero ──────────────────────────────────────────────── -->
  <section class="phero">
    <div class="phero-bg" aria-hidden="true">
      <img src="/images/work/en-corps-en-la-mer/72.jpg" alt="" loading="eager" />
    </div>
    <div class="phero-inner container">
      <p class="phero-eyebrow">Surfacing</p>
      <h1>En Corps<br /><strong>à la Mer</strong></h1>
    </div>
  </section>

  <!-- ── Ouverture : photo + citations + photo + texte ───────── -->
  <section class="opening-ecm container">

    <!-- Colonne gauche : Photo 51 -->
    <figure class="ecm-photo0">
      <img src={s('51.jpg')} alt="" loading="lazy" />
    </figure>

    <!-- Colonne droite : citations + photo 52, puis texte du projet -->
    <div class="ecm-right">

      <!-- Rangée : Nietzsche + Marin (gauche) | Photo 52 (droite) -->
      <div class="ecm-row1">
        <div class="ecm-cites">
          <Citation author="Friedrich Nietzsche — Posthumous Fragments">
            That fundamental artistic phenomenon which is called <span class="k">life</span>
          </Citation>
          <Citation author="Claire Marin — Hors de moi" note="freely translated from the French" justify>
            <span class="k">Dreams and water are two worlds where I recover a little balance, a little lightness,
            where I live again the pleasure of movement.</span> Held within the water's sheath, my body
            lets go of its pain. It fades, dissolves, vanishes. My movements turn fluid, easy;
            my body supple, almost deft. Gone, the tender catching-points: the hips, the elbows —
            nothing rasps anymore, nothing chafes, nothing tears. I remember dreaming I was a mermaid.
            My legs were imprisoned in a cocoon formed by the sheets, wound tight from turning and
            turning on myself in search of a position without pain. In the dream, the mummification
            had been transfigured into a power of movement.
          </Citation>
        </div>
        <figure class="ecm-photo1">
          <img src={s('52.jpg')} alt="" loading="lazy" />
        </figure>
      </div>

      <!-- Texte du projet -->
      <div class="ecm-project-text">
        <p class="opening-eyebrow">The project</p>
        <p class="opening-text">
          There was a season when the body gave way — when illness pulled the ground
          from under everything and strength drained off like a tide going out. <em>En Corps à la Mer</em> follows that long descent and its turning:
          force returning not through stillness, but through water. To swim was to
          be carried and to carry oneself at once — to surface, and surface again,
          until surfacing became a way of living. The series moves from dark
          interiors toward an open, dazzling white: the sea as the place where a
          life is handed back.
        </p>
        <hr class="horizon opening-horizon" />
      </div>

    </div>

  </section>

  <!-- ── Série photographique ──────────────────────────────── -->
  <div class="series">
    {spreads.map((spread) => (
      <>
        <div class={`spread spread--${spread.type} rv`}>
          {spread.photos.map((photo) => (
            <figure>
              <img
                src={photo.src}
                alt={`En Corps à la Mer — ${photo.n}`}
                loading="lazy"
              />
            </figure>
          ))}
        </div>
        {spread.caption && (
          <p class="series-caption rv">{spread.caption}</p>
        )}
      </>
    ))}
  </div>

  <!-- ── Accès galerie privée ─────────────────────────────── -->
  <div class="private-link container">
    <a href="/work/en-corps-en-la-mer/private">Complete series (private access) →</a>
  </div>

  <!-- ── Crédits ─────────────────────────────────────────── -->
  <div class="project-credits">
    <div class="group">
      <div class="label">With thanks</div>
      <p>With thanks to Jérôme Gaudin and Boriana Goranova for their friendship, to Lucie Lejeune for her support, and to Antoine d'Agata for his eye and his kindness.</p>
    </div>
  </div>

  <!-- ── Projet suivant ─────────────────────────────────────── -->
  <NextProject current="en-corps-en-la-mer" />

</Layout>

<style is:global>

  /* ── Hero projet ──────────────────────────────────── */
  .phero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(3rem, 8vh, 6rem);
    overflow: hidden;
  }

  .phero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .phero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .phero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg,
        rgba(20,32,43,.45) 0%,
        rgba(20,32,43,0) 30%,
        rgba(20,32,43,0) 55%,
        rgba(20,32,43,.62) 100%
      );
  }

  .phero-inner {
    position: relative;
    color: #fff;
  }

  .phero-eyebrow {
    font-family: var(--font-body);
    font-size: .74rem;
    text-transform: uppercase;
    letter-spacing: .2em;
    color: rgba(255,255,255,.88);
    margin-bottom: .7rem;
  }

  .phero-inner h1 {
    font-family: var(--font-title);
    font-weight: 300;
    text-transform: uppercase;
    font-size: clamp(2rem, 7vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: clamp(.04em, .8vw, .12em);
  }

  .phero-inner h1 strong { font-weight: 500; }

  /* ── Ouverture : photo + citations + photo + texte ──── */
  .opening-ecm {
    display: flex;
    gap: 16px;
    align-items: stretch;
    padding-top: clamp(3rem, 8vh, 5.5rem);
    padding-bottom: clamp(3rem, 7vh, 5rem);
    max-width: 1320px;
  }

  .ecm-photo0 {
    flex: 1 1 0;
    min-width: 0;
    margin: 0;
    overflow: hidden;
  }

  .ecm-photo0 img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ecm-right {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vh, 3rem);
  }

  .ecm-row1 {
    display: flex;
    gap: 16px;
    align-items: stretch;
  }

  .ecm-cites {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .ecm-photo1 {
    flex: 0 0 40%;
    margin: 0;
    overflow: hidden;
  }

  .ecm-photo1 img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ecm-project-text {
    display: flex;
    flex-direction: column;
  }

  /* Colonne projet */
  .opening-eyebrow {
    font-family: var(--font-body);
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .2em;
    color: var(--cerule);
    margin-bottom: 1rem;
  }

  .opening-text {
    font-weight: 300;
    font-size: clamp(.82rem, 1vw, .92rem);
    line-height: 1.85;
    color: var(--encre);
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
    flex-grow: 1;
    margin-bottom: 1.8rem;
  }

  .opening-text em { font-style: italic; }

  .opening-horizon {
    margin-top: 0;
  }

  /* ── Série ────────────────────────────────────────── */
  .series {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .spread {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .spread figure {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
  }

  .spread figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .spread--single figure { flex: 1 1 100%; }

  .series-caption {
    font-family: var(--font-title);
    font-weight: 300;
    color: var(--cerule);
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    line-height: 1.4;
    max-width: 1320px;
    margin: .5rem auto;
    padding: 0 var(--gutter);
  }

  /* Scroll fade-in */
  .rv {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity .8s ease, transform .8s ease;
  }
  .rv.in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .rv { opacity: 1; transform: none; transition: none; }
  }

  /* ── Accès privé ─────────────────────────────────── */
  .private-link {
    padding-block: 2.5rem;
    border-top: 1px solid var(--brume);
    margin-top: clamp(2rem, 5vh, 3rem);
  }

  .private-link a {
    font-family: var(--font-body);
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .16em;
    color: var(--ardoise);
    border-bottom: 1px solid var(--brume);
    padding-bottom: 2px;
    transition: color .25s;
  }

  .private-link a:hover { color: var(--cerule); }

  /* ── Project credits ─────────────────────────────── */
  .project-credits {
    max-width: 62ch;
    margin: clamp(2.5rem, 6vh, 4rem) auto 0;
    padding: 0 var(--gutter);
  }
  .project-credits .group + .group { margin-top: 1rem; }
  .project-credits .label {
    font-family: var(--font-title);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .2em;
    font-size: .62rem;
    color: var(--cerule);
    margin-bottom: .4rem;
  }
  .project-credits p {
    font-size: .8rem;
    line-height: 1.55;
    color: var(--ardoise);
    margin: 0;
  }

  /* ── Mobile ───────────────────────────────────────── */
  @media (max-width: 700px) {
    .opening-ecm {
      flex-direction: column;
      gap: 2rem;
    }
    .ecm-photo0 img { height: 60vw; }
    .ecm-row1 { flex-direction: column; }
    .ecm-photo1 { flex: 0 0 auto; }
    .ecm-photo1 img { height: auto; }
    .series { gap: 8px; }
    .spread { flex-wrap: wrap; gap: 8px; }
    .spread figure {
      flex: none !important;
      width: calc(50% - 4px) !important;
    }
    .spread--single figure { width: 100% !important; }

    /* Trio : 3 colonnes égales pour éviter le blanc */
    .spread--row:has(figure:nth-child(3)):not(:has(figure:nth-child(4))) figure {
      width: calc(33.33% - 6px) !important;
    }

    /* Hauteur uniforme dans les rangées de 2 */
    .spread--row:not(:has(figure:nth-child(3))) figure {
      aspect-ratio: 3 / 2;
      overflow: hidden;
    }
    .spread--row:not(:has(figure:nth-child(3))) figure img {
      height: 100%;
      object-fit: cover;
    }
  }

</style>

<script>
  // Justified row layout
  function justify() {
    const mob = window.innerWidth <= 700;
    document.querySelectorAll<HTMLElement>('.spread--row').forEach(row => {
      const figs = Array.from(row.querySelectorAll<HTMLElement>('figure'));
      const imgs = figs.map(f => f.querySelector('img') as HTMLImageElement);
      function apply() {
        if (mob) { figs.forEach(f => { f.style.flexGrow = ''; }); return; }
        imgs.forEach((im, i) => {
          const r = (im.naturalWidth && im.naturalHeight)
            ? im.naturalWidth / im.naturalHeight : 1;
          figs[i].style.flexGrow = r.toFixed(4);
        });
      }
      if (imgs.every(im => im.complete && im.naturalWidth)) apply();
      else imgs.forEach(im => im.addEventListener('load', apply));
    });
  }
  justify();
  window.addEventListener('resize', () => {
    clearTimeout((window as any)._jt);
    (window as any)._jt = setTimeout(justify, 150);
  });

  // Scroll reveal
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
    });
  }, { threshold: .06 });
  document.querySelectorAll('.rv').forEach(el => obs.observe(el));

</script>
