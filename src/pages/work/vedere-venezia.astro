---
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/work-project.css';
import Citation from '../../components/Citation.astro';
import NextProject from '../../components/NextProject.astro';

const s = (file: string) => `/images/work/vedere-venezia/${file}`;

type Photo = { src: string; n: number };
type Spread = {
  type: 'row' | 'single';
  photos: Photo[];
};

const p = (n: number): Photo => ({ src: s(`${n}.jpg`), n });

const aznavourEN = `How sad Venice is<br />On the evenings on the lagoon<br />When you reach for a hand<br />That no one holds out to you<br />And you make light of it all<br />Under the moonlight<br />To try to forget<br />What you never say to each other`;
const dufourmantellEN = `To part, in this way, is to begin translating. It is to find at least one word to translate what in oneself signifies and makes sense, in a new language, so that it may be heard by another. It is to leave the mother tongue to risk one's own language — the poetic language par excellence.`;

const spreads: Spread[] = [
  { type: 'single', photos: [p(3)] },
  { type: 'row',    photos: [p(4), p(5)] },
  { type: 'row',    photos: [p(6), p(7), p(8)] },
  { type: 'single', photos: [p(9)] },
  { type: 'row',    photos: [p(10), p(11)] },
  { type: 'single', photos: [p(12)] },
];
---

<Layout
  title="Vedere Venezia e Non Morire · Laurie Di Francesco"
  description="Vedere Venezia e Non Morire · Seeing Venice without dying from it. A city seen from over the cliché's shoulder."
  image="/images/work/vedere-venezia-cover.jpg"
  bodyClass="page-venezia"
  lightHeader={false}
>

  <!-- ── Hero ──────────────────────────────────────────────── -->
  <section class="phero">
    <div class="phero-bg" aria-hidden="true">
      <img src="/images/work/vedere-venezia/7.jpg" alt="" loading="eager" />
    </div>
    <div class="phero-inner container">
      <p class="phero-eyebrow">Rebirth. An attempt.</p>
      <h1>Vedere Venezia<br /><strong>e Non Morire</strong></h1>
    </div>
  </section>

  <!-- ── Épigraphes ──────────────────────────────────────────── -->
  <section class="gal-opening">

    <div class="gal-row rv">
      <figure class="gal-cell gal-cell--photo">
        <img src={s('1.jpg')} alt="" loading="lazy" />
      </figure>
      <div class="gal-cell gal-cell--cit">
        <Citation author="Charles Aznavour · Que c'est triste Venise" note="free translation from the French">
          <Fragment set:html={aznavourEN} />
        </Citation>
      </div>
    </div>

    <div class="gal-row rv">
      <div class="gal-cell gal-cell--cit">
        <Citation author="Anne Dufourmantelle" note="free translation from the French">
          <Fragment set:html={dufourmantellEN} />
        </Citation>
      </div>
      <figure class="gal-cell gal-cell--photo">
        <img src={s('2.jpg')} alt="" loading="lazy" />
      </figure>
    </div>

    <div class="gal-row rv">
      <div class="gal-cell gal-cell--text">
        <p class="opening-eyebrow">The Project</p>
        <p class="opening-text">The title turns a proverb around. See Venice and die: beauty as an ending, the place where one may stop. Here, it is a matter of passing through it and going on.</p>
        <p class="opening-text">The series begins with a child under an umbrella patterned with hearts. It moves through the night and returns to daylight, like a necessity to be reborn.</p>
        <p class="opening-text">Venice is a place of family memory, and it had to be crossed again, alone, to be made into something else.</p>
        <p class="opening-text">The second to last image superimposes two time frames: a family archive photograph, and an image taken on a phone at the very moment the return to this weighted place was coming to an end. The starting point of the project and the point of exit coincide in a single image, as if a final full stop had at last to be set down. A necessary separation, of which only the road sign remains here.</p>
        <p class="opening-text">From this coincidence a last figure emerges, in a shop window reflection. Something of Gelsomina, in Fellini: wonder passing through brutality without being undone by it. Not the naivety that came before, but innocence as a conquest, the kind that comes after. It is the figure of the lion becoming a child, in Nietzsche, and it returns from one project to the next.</p>
        <hr class="horizon" />
      </div>
    </div>

  </section>

  <!-- ── Série photographique ──────────────────────────────── -->
  {spreads.length > 0 && (
    <div class="series">
      {spreads.map((spread) => (
        <div class={`spread spread--${spread.type} rv`}>
          {spread.photos.map((photo) => (
            <figure>
              <img
                src={photo.src}
                alt={`Vedere Venezia e Non Morire · ${photo.n}`}
                loading="lazy"
              />
            </figure>
          ))}
        </div>
      ))}
    </div>
  )}

  <!-- ── Projet suivant ─────────────────────────────────────── -->
  <NextProject current="vedere-venezia" />

</Layout>

<style is:global>

  /* ── Mobile ───────────────────────────────────────── */
  @media (max-width: 700px) {
    .phero-bg img { object-position: 65% center; }
  }

</style>

<script>
  // Justified row layout
  function justify() {
    const mob = window.innerWidth <= 700;
    document.querySelectorAll<HTMLElement>('.spread--row').forEach(row => {
      const figs = Array.from(row.querySelectorAll<HTMLElement>('figure'));
      const imgs = figs.map(f => f.querySelector<HTMLImageElement>('img')!);
      const getR = (im: HTMLImageElement) =>
        (im.naturalWidth && im.naturalHeight) ? im.naturalWidth / im.naturalHeight : 1;
      function apply() {
        if (mob && figs.length === 3) {
          figs[0].style.flex = `${getR(imgs[0]).toFixed(4)} 1 0`;
          figs[1].style.flex = `${getR(imgs[1]).toFixed(4)} 1 0`;
          figs[2].style.flex = '0 0 100%';
          return;
        }
        if (mob && figs.length === 4) {
          const avail = row.clientWidth - 8;
          ([[0,1],[2,3]] as [number,number][]).forEach(([a,b]) => {
            const ra = getR(imgs[a]), rb = getR(imgs[b]);
            const wa = Math.round(ra / (ra + rb) * avail);
            figs[a].style.flex = `0 0 ${wa}px`;
            figs[b].style.flex = `0 0 ${avail - wa}px`;
          });
          return;
        }
        imgs.forEach((im, i) => {
          figs[i].style.flex = '';
          figs[i].style.flexGrow = getR(im).toFixed(4);
        });
      }
      if (imgs.every(im => im.complete && im.naturalWidth)) apply();
      else imgs.forEach(im => im.addEventListener('load', apply));
    });
  }
  function layoutGalRows() {
    const mob = window.innerWidth <= 700;
    const H = parseFloat(getComputedStyle(document.body).getPropertyValue('--rowh')) || 380;
    document.querySelectorAll<HTMLElement>('.gal-cell--photo').forEach(cell => {
      const img = cell.querySelector<HTMLImageElement>('img');
      if (!img) return;
      function apply() {
        if (mob) { cell.style.width = ''; return; }
        const r = img!.naturalWidth && img!.naturalHeight
          ? img!.naturalWidth / img!.naturalHeight : 1;
        cell.style.width = Math.round(r * H) + 'px';
      }
      if (img.complete && img.naturalWidth) apply();
      else img.addEventListener('load', apply);
    });
  }
  justify();
  layoutGalRows();
  window.addEventListener('resize', () => {
    clearTimeout((window as any)._jt);
    (window as any)._jt = setTimeout(() => { justify(); layoutGalRows(); }, 150);
  });

  // Scroll reveal
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
    });
  }, { threshold: .06 });
  document.querySelectorAll('.rv').forEach(el => obs.observe(el));

</script>
