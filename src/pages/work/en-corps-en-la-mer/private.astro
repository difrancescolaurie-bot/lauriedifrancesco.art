---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/pages/work-project.css';
import Citation from '../../../components/Citation.astro';
import NextProject from '../../../components/NextProject.astro';

const PASSWORD = 'surfacing';

type Photo = { src: string; n: number; w: number; h: number };
type Spread = { type: 'row' | 'single'; photos: Photo[] };

const pub = (n: number): Photo => ({
  src: `/images/work/en-corps-en-la-mer/${n}.jpg`,
  n,
  w: 2000,
  h: n === 52 ? 1334 : 1333,
});
const prv = (n: number): Photo => ({
  src: `/images/work/ecm-private/${n}.jpg`,
  n,
  w: 1600,
  h: 1066,
});

const spreads: Spread[] = [
  // La chute — intérieur, maladie
  { type: 'row',    photos: [pub(53), prv(54), pub(56)] },
  // Les seuils — fenêtres, attente
  { type: 'row',    photos: [pub(55), pub(59)] },
  // Vers l'eau — la mer apparaît
  { type: 'row',    photos: [pub(57), pub(58), pub(60), pub(61)] },
  { type: 'single', photos: [pub(62)] },
  // L'immersion — le corps dans l'eau
  { type: 'row',    photos: [prv(63), pub(64), pub(65), pub(67)] },
  // Les signes — flottements, objets, le flamant
  { type: 'row',    photos: [pub(66), pub(70), pub(71), pub(72)] },
  { type: 'row',    photos: [pub(73), pub(74)] },
  // Refaire surface — vers la blancheur
  { type: 'row',    photos: [prv(68), pub(69)] },
  { type: 'row',    photos: [prv(75), pub(76)] },
];
---

<Layout
  title="En Corps à la Mer · Complete series"
  description=""
  hasTranslations={false}
  noindex={true}
  lightHeader={false}
  bodyClass="page-ecm"
>

  <!-- ── Gate mot de passe ──────────────────────────────────── -->
  <div class="gate" id="gate">
    <div class="gate-inner">
      <p class="gate-eyebrow">En Corps à la Mer</p>
      <p class="gate-title">Complete series</p>
      <p class="gate-sub">Private access</p>
      <form class="gate-form" id="gate-form" autocomplete="off">
        <input
          type="password"
          id="pw"
          class="gate-input"
          placeholder="Password"
          aria-label="Password"
          autocomplete="current-password"
        />
        <button type="submit" class="gate-btn">Enter</button>
      </form>
      <p class="gate-error" id="gate-error" aria-live="polite"></p>
    </div>
  </div>

  <!-- ── Page projet ────────────────────────────────────────── -->
  <div id="pgallery" aria-hidden="true" style="display:none">

    <!-- ── Hero ──────────────────────────────────────────────── -->
    <section class="phero">
      <div class="phero-bg" aria-hidden="true">
        <img src="/images/work/en-corps-en-la-mer/72.jpg" alt="" loading="eager" />
      </div>
      <div class="phero-inner container">
        <p class="phero-eyebrow">Surfacing</p>
        <h1>En Corps<br /><strong>à la Mer</strong></h1>
        <p class="phero-count" aria-live="polite"></p>
      </div>
    </section>

    <!-- ── Ouverture : deux rangées photo + citation ── -->
    <section class="gal-opening">

      <div class="gal-row rv">
        <figure class="gal-cell gal-cell--photo">
          <img src="/images/work/en-corps-en-la-mer/51.jpg" alt="" loading="lazy" data-no-lightbox width="2000" height="1333" />
        </figure>
        <div class="gal-cell gal-cell--cit">
          <Citation author="Friedrich Nietzsche · Posthumous Fragments">
            That fundamental artistic phenomenon which is called life
          </Citation>
        </div>
      </div>

      <div class="gal-row rv">
        <div class="gal-cell gal-cell--cit">
          <Citation author="Claire Marin · Hors de moi" note="freely translated from the French">
            Dreams and water are two worlds where I find a little balance again, a little lightness,
            where I live again the pleasure of movement. Sheathed and held by the water, my body
            sheds its pain. It fades, it wears away, it vanishes. Gestures become fluid, easy,
            the body supple, almost deft. Vanished, the tender catching points: the hips, the elbows,
            nothing rasps anymore, nothing chafes, nothing tears. I remember dreaming I was a mermaid.
            My legs were imprisoned in a cocoon formed by the sheets, wound from turning and turning
            on myself in search of a painless position. In the dream, the mummification had turned
            into a power of movement.
          </Citation>
        </div>
        <figure class="gal-cell gal-cell--photo">
          <img src="/images/work/en-corps-en-la-mer/52.jpg" alt="" loading="lazy" data-no-lightbox width="2000" height="1334" />
        </figure>
      </div>

    </section>

    <!-- ── Texte du projet ──────────────────────────────────── -->
    <div class="ecm-text">
      <p class="opening-eyebrow">The project</p>
      <p class="opening-text">
        There was a season when the body gave way, when illness pulled the ground
        from under everything and strength drained off like a tide going out. <em>En Corps à la Mer</em> follows that long descent and its turning:
        force returning not through stillness, but through water. To swim was to
        be carried and to carry oneself at once. To surface, and surface again,
        until surfacing became a way of living. The series moves from dark
        interiors toward an open, dazzling white: the sea as the place where a
        life is handed back.
      </p>
      <hr class="horizon opening-horizon" />
    </div>

    <!-- ── Série photographique ──────────────────────────────── -->
    <div class="series" id="serie">
      {spreads.map((spread) => (
        <>
          <div class={`spread spread--${spread.type} rv`}>
            {spread.photos.map((photo) => (
              <figure>
                <img
                  src={photo.src}
                  alt={`En Corps à la Mer · ${photo.n}`}
                  loading="lazy"
                  data-no-lightbox
                  width={photo.w}
                  height={photo.h}
                />
              </figure>
            ))}
          </div>
        </>
      ))}
    </div>

    <!-- ── Crédits ─────────────────────────────────────────── -->
    <div class="project-credits">
      <div class="group">
        <div class="label">With thanks</div>
        <p>With thanks to Jérôme Gaudin and Boriana Goranova for their friendship, to Lucie Lejeune for her support, and to Antoine d'Agata for his eye, his kindness and his generosity.</p>
      </div>
    </div>

    <!-- ── Projet suivant ─────────────────────────────────────── -->
    <NextProject current="en-corps-en-la-mer" />

  </div>

</Layout>

<style is:global>

  /* ── Gate ──────────────────────────────────────────────── */
  .gate {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--encre);
  }

  .gate-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    padding: 3rem;
    max-width: 380px;
    width: 100%;
  }

  .gate-eyebrow {
    font-family: var(--font-body);
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .22em;
    color: rgba(255,255,255,.45);
    text-align: center;
  }

  .gate-title {
    font-family: var(--font-title);
    font-weight: 300;
    font-size: clamp(1.4rem, 4vw, 2rem);
    text-transform: uppercase;
    letter-spacing: .1em;
    color: #fff;
    text-align: center;
    line-height: 1.15;
  }

  .gate-sub {
    font-family: var(--font-body);
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: var(--cerule);
    text-align: center;
  }

  .gate-form {
    display: flex;
    gap: .6rem;
    width: 100%;
    margin-top: .5rem;
  }

  .gate-input {
    flex: 1 1 0;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 2px;
    padding: .65rem 1rem;
    font-family: var(--font-body);
    font-size: .85rem;
    color: #fff;
    outline: none;
    transition: border-color .2s;
  }

  .gate-input::placeholder { color: rgba(255,255,255,.35); }
  .gate-input:focus { border-color: var(--cerule); }

  .gate-btn {
    background: var(--cerule);
    border: none;
    border-radius: 2px;
    padding: .65rem 1.4rem;
    font-family: var(--font-body);
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: #fff;
    cursor: pointer;
    transition: opacity .2s;
  }

  .gate-btn:hover { opacity: .85; }

  .gate-error {
    font-family: var(--font-body);
    font-size: .72rem;
    color: #e07070;
    min-height: 1em;
    text-align: center;
  }

  @media (max-width: 700px) {
    .gate-form { flex-direction: column; }
    .gate-btn { width: 100%; }
  }

</style>

<script define:vars={{ PASSWORD }}>
  const form    = document.getElementById('gate-form');
  const gate    = document.getElementById('gate');
  const gallery = document.getElementById('pgallery');
  const errEl   = document.getElementById('gate-error');

  function unlock() {
    gate.style.display = 'none';
    gallery.style.display = 'block';
    gallery.removeAttribute('aria-hidden');
    initPage();
  }

  // Preserve lang from referrer page
  const urlLang = new URLSearchParams(location.search).get('lang');
  if (urlLang) {
    const backLink = document.querySelector('#pgallery .next-project a');
    if (backLink) backLink.setAttribute('href', '/' + urlLang + '/work/en-corps-en-la-mer');
  }

  if (sessionStorage.getItem('ecm-private-auth') === '1') unlock();

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    const pw = document.getElementById('pw').value;
    if (pw === PASSWORD) {
      sessionStorage.setItem('ecm-private-auth', '1');
      unlock();
    } else {
      errEl.textContent = 'Incorrect password.';
    }
  });

  function initPage() {
    // Photo count — series images only (24 total: 20 public + 4 private)
    const countEl = document.querySelector('.phero-count');
    if (countEl) countEl.textContent = '24 photographs';

    // Justified row layout — full version matching public page
    function justify() {
      const mob = window.innerWidth <= 700;
      document.querySelectorAll('.spread--row').forEach(function(row) {
        const figs = Array.from(row.querySelectorAll('figure'));
        const imgs = figs.map(function(f) { return f.querySelector('img'); });
        function getR(im) {
          return (im.naturalWidth && im.naturalHeight) ? im.naturalWidth / im.naturalHeight : 1;
        }
        function apply() {
          if (mob && figs.length === 2) {
            const avail = row.clientWidth - 4;
            const r0 = getR(imgs[0]), r1 = getR(imgs[1]);
            const w0 = Math.round(r0 / (r0 + r1) * avail);
            figs[0].style.flex = '0 0 ' + w0 + 'px';
            figs[1].style.flex = '0 0 ' + (avail - w0) + 'px';
            return;
          }
          if (mob && figs.length === 3) {
            const avail = row.clientWidth - 4;
            const r0 = getR(imgs[0]), r1 = getR(imgs[1]);
            const w0 = Math.round(r0 / (r0 + r1) * avail);
            figs[0].style.flex = '0 0 ' + w0 + 'px';
            figs[1].style.flex = '0 0 ' + (avail - w0) + 'px';
            figs[2].style.flex = '0 0 100%';
            return;
          }
          if (mob && figs.length === 4) {
            const avail = row.clientWidth - 4;
            [[0,1],[2,3]].forEach(function(pair) {
              const a = pair[0], b = pair[1];
              const ra = getR(imgs[a]), rb = getR(imgs[b]);
              const wa = Math.round(ra / (ra + rb) * avail);
              figs[a].style.flex = '0 0 ' + wa + 'px';
              figs[b].style.flex = '0 0 ' + (avail - wa) + 'px';
            });
            return;
          }
          imgs.forEach(function(im, i) {
            figs[i].style.flex = getR(im).toFixed(4) + ' 1 0';
          });
        }
        if (imgs.every(function(im) { return im.complete && im.naturalWidth; })) apply();
        else imgs.forEach(function(im) { im.addEventListener('load', apply); });
      });
    }

    // Opening row layout (gal-cell--photo width calculation)
    function layoutGalRows() {
      const mob = window.innerWidth <= 700;
      const H = parseFloat(getComputedStyle(document.body).getPropertyValue('--rowh')) || 380;
      document.querySelectorAll('.gal-cell--photo').forEach(function(cell) {
        const img = cell.querySelector('img');
        if (!img) return;
        function apply() {
          if (mob) { cell.style.width = ''; return; }
          const r = (img.naturalWidth && img.naturalHeight)
            ? img.naturalWidth / img.naturalHeight : 1;
          cell.style.width = Math.round(r * H) + 'px';
        }
        if (img.complete && img.naturalWidth) apply();
        else img.addEventListener('load', apply);
      });
    }

    justify();
    layoutGalRows();
    window.addEventListener('resize', function() {
      clearTimeout(window._jt);
      window._jt = setTimeout(function() { justify(); layoutGalRows(); }, 150);
    });

    // Scroll reveal
    const obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
      });
    }, { threshold: .06 });
    document.querySelectorAll('.rv').forEach(function(el) { obs.observe(el); });
  }
</script>
