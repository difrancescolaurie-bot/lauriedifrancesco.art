---
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/work-index.css';
import Citation from '../../components/Citation.astro';

const projects = [
  {
    href: '/work/quando-sono-qui',
    title: 'Quando sono qui, non sono là',
    cerule: 'Resignifying',
    note: 'Being there means missing here. Or does it?',
    image: '/images/work/quando-cover.jpg',
    overlayColor: 'rgba(138,72,42,.92)',
  },
  {
    href: '/work/toward-the-blue',
    title: 'Toward the Blue',
    cerule: 'dreaming',
    note: 'Look up into the blue of the sky. Dream of a lightness lost.',
    image: '/images/work/toward-the-blue-cover.jpg',
    overlayColor: 'rgba(36,44,72,.92)',
  },
  {
    href: '/work/en-corps-en-la-mer',
    title: 'En Corps à la Mer',
    cerule: 'Surfacing',
    note: 'Learning to walk again, through water and through dreams.',
    image: '/images/work/en-corps-cover.jpg',
    overlayColor: 'rgba(26,20,32,.92)',
  },
  {
    href: '/work/vedere-venezia',
    title: 'Vedere Venezia e Non Morire',
    cerule: 'Rebirth. An attempt.',
    note: "To hold on. To let go. To exist in one's own gaze.",
    image: '/images/work/vedere-venezia-cover.jpg',
    overlayColor: 'rgba(54,52,48,.92)',
  },
  {
    href: '/work/spilling-beyond-the-lines',
    title: 'Spilling Beyond the Lines',
    cerule: 'Do lines truly divide?',
    note: "When the free profusion of forms around us, and another's gaze, rewrote my own: a work born of a rupture that draws us closer.",
    image: '/images/work/spilling-cover.jpg',
    overlayColor: 'rgba(38,66,42,.92)',
  },
  {
    href: '/work/la-mer-en-corps',
    title: 'La Mer en Corps',
    cerule: 'Tracing',
    note: 'Water and dreams, giving body to movement. A year of passages.',
    image: '/images/work/la-mer-en-corps-cover.jpg',
    overlayColor: 'rgba(28,58,74,.92)',
  },
];
---

<Layout
  title="Projects"
  description="Stories in Images — Laurie Di Francesco, photography and writing."
>

  <!-- ── Page head (inchangé) ────────────────── -->
  <section class="wi-head container">
    <p class="wi-eyebrow">Projects</p>
    <h1 class="wi-h1">Stories in Images</h1>

    <Citation author="Claudia Andujar" justify>
      To photograph is the process of discovering the other and, through the other, oneself.
      Ultimately, that is why the photographer seeks and discovers new worlds, but always ends
      up <span class="k">revealing what lies within</span>.
    </Citation>
  </section>

  <div class="wi-projects">

  <!-- ════════════════════════════════════════════
    01 · QUANDO SONO QUI
    Meta haut-gauche — image saigne droite — note bas
  ═════════════════════════════════════════════ -->
  <section class="p1">
    <div class="proj-head">
      <span class="wi-cerule">{projects[0].cerule}</span>
      <h2 class="wi-title" set:html="Quando&nbsp;sono&nbsp;qui, non&nbsp;sono&nbsp;là" />
    </div>
    <div class="p1-img-wrap">
      <a class="proj-img" href={projects[0].href}
         data-overlay-color={projects[0].overlayColor}
         data-overlay-cerule={projects[0].cerule}
         data-overlay-title={projects[0].title}
         data-overlay-note={projects[0].note}>
        <img src={projects[0].image} alt={projects[0].title} loading="lazy" />
      </a>
    </div>
  </section>

  <hr class="proj-sep" />

  <!-- ════════════════════════════════════════════
    06 · LA MER EN CORPS
    Miroir de P1 — meta haut-droite, image saigne gauche
  ═════════════════════════════════════════════ -->
  <section class="p6">
    <div class="proj-head">
      <span class="wi-cerule">{projects[5].cerule}</span>
      <h2 class="wi-title">{projects[5].title}</h2>
    </div>
    <div class="p6-img-wrap">
      <a class="proj-img" href={projects[5].href}
         data-overlay-color={projects[5].overlayColor}
         data-overlay-cerule={projects[5].cerule}
         data-overlay-title={projects[5].title}
         data-overlay-note={projects[5].note}>
        <img src={projects[5].image} alt={projects[5].title} loading="lazy" />
      </a>
    </div>
  </section>

  <div class="proj-section-divider">
    <hr />
    <p class="proj-section-divider-label">Previous works</p>
  </div>

  <!-- ════════════════════════════════════════════
    02 · TOWARD THE BLUE
    Image saigne gauche — texte droite décalé bas
  ═════════════════════════════════════════════ -->
  <section class="p2">
    <div class="p2-img-side">
      <a class="proj-img" href={projects[1].href}
         data-overlay-color={projects[1].overlayColor}
         data-overlay-cerule={projects[1].cerule}
         data-overlay-title={projects[1].title}
         data-overlay-note={projects[1].note}>
        <img src={projects[1].image} alt={projects[1].title} loading="lazy" />
      </a>
    </div>
    <div class="p2-text-side">
      <span class="wi-cerule">{projects[1].cerule}</span>
      <h2 class="wi-title">{projects[1].title}</h2>
    </div>
  </section>

  <hr class="proj-sep" />

  <!-- ════════════════════════════════════════════
    03 · EN CORPS À LA MER
    Plein bord — meta dessous
  ═════════════════════════════════════════════ -->
  <section class="p3">
    <a class="proj-img" href={projects[2].href}
       data-overlay-color={projects[2].overlayColor}
       data-overlay-cerule={projects[2].cerule}
       data-overlay-title={projects[2].title}
       data-overlay-note={projects[2].note}>
      <img src={projects[2].image} alt={projects[2].title} loading="lazy" />
    </a>
    <div class="p3-meta">
      <span class="wi-cerule">{projects[2].cerule}</span>
      <h2 class="wi-title">{projects[2].title}</h2>
    </div>
  </section>

  <hr class="proj-sep" />

  <!-- ════════════════════════════════════════════
    04 · VEDERE VENEZIA
    Image droite-centre — titre grand + note dessous
  ═════════════════════════════════════════════ -->
  <section class="p4">
    <div class="p4-img-row">
      <a class="proj-img" href={projects[3].href}
         data-overlay-color={projects[3].overlayColor}
         data-overlay-cerule={projects[3].cerule}
         data-overlay-title={projects[3].title}
         data-overlay-note={projects[3].note}>
        <img src={projects[3].image} alt={projects[3].title} loading="lazy" />
      </a>
    </div>
    <div class="p4-below">
      <span class="wi-cerule">{projects[3].cerule}</span>
      <h2 class="p4-title-big">{projects[3].title}</h2>
    </div>
  </section>

  <hr class="proj-sep" />

  <!-- ════════════════════════════════════════════
    05 · SPILLING BEYOND THE LINES
    Titre géant — image saigne gauche — note droite
  ═════════════════════════════════════════════ -->
  <section class="p5">
    <div class="p5-img-side">
      <a class="proj-img" href={projects[4].href}
         data-overlay-color={projects[4].overlayColor}
         data-overlay-cerule={projects[4].cerule}
         data-overlay-title={projects[4].title}
         data-overlay-note={projects[4].note}>
        <img src={projects[4].image} alt={projects[4].title} loading="lazy" />
      </a>
    </div>
    <div class="p5-text-side">
      <span class="wi-cerule">{projects[4].cerule}</span>
      <h2 class="wi-title">{projects[4].title}</h2>
    </div>
  </section>


  </div><!-- /wi-projects -->

</Layout>

<!-- ── Overlay pleine page ────────────────────── -->
<div id="fso" aria-hidden="true">
  <div id="fso-bg"></div>
  <div id="fso-content">
    <span id="fso-cerule"></span>
    <p id="fso-title"></p>
    <p id="fso-note"></p>
    <a id="fso-cta" href="#">View project →</a>
  </div>
  <button id="fso-close" aria-label="Close">×</button>
</div>

<script>
  const fso       = document.getElementById('fso')!;
  const fsoBg     = document.getElementById('fso-bg')!;
  const fsoCerule = document.getElementById('fso-cerule')!;
  const fsoTitle  = document.getElementById('fso-title')!;
  const fsoNote   = document.getElementById('fso-note')!;
  const fsoCta    = document.getElementById('fso-cta') as HTMLAnchorElement;
  const fsoClose  = document.getElementById('fso-close')!;
  let hideTimer: ReturnType<typeof setTimeout>;

  function showFso(el: HTMLAnchorElement) {
    clearTimeout(hideTimer);
    fsoBg.style.background    = el.dataset.overlayColor ?? 'rgba(20,32,43,.92)';
    fsoCerule.textContent     = el.dataset.overlayCerule ?? '';
    fsoTitle.textContent      = el.dataset.overlayTitle ?? '';
    fsoNote.textContent       = el.dataset.overlayNote ?? '';
    fsoCta.href               = el.href;
    fso.setAttribute('aria-hidden', 'false');
    fso.classList.add('on');
  }

  function hideFso(delay = 120) {
    hideTimer = setTimeout(() => {
      fso.classList.remove('on');
      fso.setAttribute('aria-hidden', 'true');
    }, delay);
  }

  document.querySelectorAll<HTMLAnchorElement>('.proj-img').forEach(el => {
    el.addEventListener('click', e => {
      e.preventDefault();
      fso.classList.contains('on') ? hideFso(0) : showFso(el);
    });
  });

  fsoClose.addEventListener('click', () => hideFso(0));
  fso.addEventListener('click', e => {
    if (e.target === fso || e.target === fsoBg) hideFso(0);
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') hideFso(0); });
</script>
