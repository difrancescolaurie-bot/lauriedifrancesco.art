---
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/work-project.css';
---

<Layout
  title="La Mer en Corps — Laurie Di Francesco"
  description="La Mer en Corps — water and dreams, giving body to movement. A year of passages."
  image="/images/work/la-mer-en-corps-cover.jpg"
>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="phero">
    <div class="phero-bg" aria-hidden="true">
      <img
        src="/images/work/la-mer-en-corps-cover.jpg"
        alt=""
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="phero-inner container">
      <p class="phero-eyebrow">Tracing</p>
      <h1>La Mer<br /><strong>en Corps</strong></h1>
    </div>
  </section>

  <!-- ── Vidéo (embed Vimeo) ──────────────────────────────── -->
  <div class="pvideo rv">
    <iframe
      src="https://player.vimeo.com/video/1215012910"
      allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
      allowfullscreen
      title="La Mer en Corps"
      loading="lazy"
    ></iframe>
  </div>

  <p class="series-caption rv">Water and dreams, giving body to movement. A year of passages.</p>

  <!-- ── Projet suivant ───────────────────────────────────── -->
  <div class="next-project container">
    <span class="next-label">Next project</span>
    <a href="/work/quando-sono-qui">Quando sono qui, non sono là →</a>
  </div>

</Layout>

<script>
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
    });
  }, { threshold: .06 });
  document.querySelectorAll('.rv').forEach(el => obs.observe(el));
</script>
