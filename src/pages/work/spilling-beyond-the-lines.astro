---
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/work-project.css';
import Citation from '../../components/Citation.astro';
import NextProject from '../../components/NextProject.astro';

const s = (path: string) => `/images/spilling/${path}`;

type Photo = { src: string; full: string; n: number; figClass?: string };
type Spread = {
  type: 'row' | 'single' | 'composed';
  photos: Photo[];
  caption?: string;
  noLand?: boolean;
};

const local = (file: string, n: number, figClass?: string): Photo => ({
  src: s(file), full: s(file), n, ...(figClass && { figClass })
});

const spreads: Spread[] = [
  // Photos 3–6
  { type: 'row', photos: [local('3.jpg',3), local('4.jpg',4), local('5.jpg',5), local('6.jpg',6)] },
  // Photos 7–10
  { type: 'row', photos: [local('7.jpg',7), local('8.jpg',8), local('9.jpg',9), local('10.jpg',10)] },
  // Photos 11–13
  { type: 'row', photos: [local('11.jpg',11), local('12.jpg',12), local('13.jpg',13)] },
  // Photos 14–17
  { type: 'row', photos: [local('14.jpg',14), local('15.jpg',15), local('16.jpg',16), local('17.jpg',17)] },
  // Photos 18–21 (21 = match)
  { type: 'row', photos: [local('18.jpg',18), local('19.jpg',19), local('20.jpg',20), local('21.jpg',21,'port-crop')] },
  // Photos 22, 23 (chacune seule)
  { type: 'single', photos: [local('22.jpg',22)] },
  { type: 'single', photos: [local('23.jpg',23)] },
  // Photos 24–25
  { type: 'row', photos: [local('24.jpg',24), local('25.jpg',25)] },
  // Photos 26–29
  { type: 'row', photos: [local('26.jpg',26), local('27.jpg',27), local('28.jpg',28), local('29.jpg',29)] },
  // Photo 30 (single)
  { type: 'single', photos: [local('30.jpg',30)] },
  // Photos 31–34
  { type: 'row', photos: [local('31.jpg',31), local('32.jpg',32), local('33.jpg',33), local('34.jpg',34)] },
  // Photos 35–38
  { type: 'row', photos: [local('35.jpg',35), local('36.jpg',36), local('37.jpg',37), local('38.jpg',38)] },
  // Photos 40–41 (portraits)
  { type: 'row', photos: [local('40.jpg',40), local('41.jpg',41)] },
  // Photos 42–43 (portraits)
  { type: 'row', photos: [local('42.jpg',42), local('43.jpg',43)] },
  // Photo 44 + 47 en rangée
  { type: 'row', photos: [local('44.jpg',44), local('47.jpg',47,'land-crop')] },
];
---

<Layout
  title="Spilling Beyond the Lines · Laurie Di Francesco"
  description="A photobook born from displacement and the question of borders · Belo Horizonte, Brazil, 2024."
  image="/images/work/spilling-cover.jpg"
  bodyClass="page-spill"
  lightHeader={false}
>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="phero">
    <div class="phero-bg" aria-hidden="true">
      <img
        src="/images/spilling/47.jpg"
        alt=""
        loading="eager"
      />
    </div>
    <div class="phero-inner container">
      <p class="phero-eyebrow">Do lines truly divide?</p>
      <h1>Spilling Beyond<br /><strong>the Lines</strong></h1>
      <p class="phero-count" aria-live="polite"></p>
    </div>
  </section>

  <!-- ── Intro ─────────────────────────────────────────────── -->
  <section class="gal-opening">

    <div class="gal-row rv">
      <figure class="gal-cell gal-cell--photo">
        <img src={s('2.jpg')} alt="Spilling Beyond the Lines · photo 2" loading="lazy" />
      </figure>
      <div class="gal-cell gal-cell--cit">
        <Citation author="Gilberto Gil · Back in Bahia">
          Por algum tempo<br />
          Que afinal passou depressa, como tudo tem de passar<br />
          Hoje eu me sinto<br />
          Como se ter ido fosse necessário para voltar<br />
          Tanto mais vivo<br />
          De vida mais vivida, dividida pra lá e pra cá
        </Citation>
      </div>
    </div>

    <div class="gal-row rv">
      <div class="gal-cell gal-cell--text">
        <p class="opening-eyebrow">The project</p>
        <p class="intro-text">This project did not begin with a theme. It began with an archive: twenty years of images, several continents, accumulated without a plan. One day they had to be reread, in search of what ran through them all.</p>
        <p class="intro-text">What appeared were lines. Geographical ones first, since these images come from different countries. But above all the others: social, economic, racial. The ones that appear on no map and that everyone knows how to see.</p>
        <p class="intro-text">These photographs were not taken in passing. They come from inhabited places, from streets walked every day, from countries where I lived as a foreigner, as an immigrant. My gaze does not look down from above: it is caught in what it looks at, on one side of the lines here, on the other side there.</p>
        <p class="intro-text">Spilling beyond the lines does not mean denying them. They exist, they separate, some cannot be crossed. But a life can spill beyond them, and an image can hold together what the map keeps apart.</p>
        <p class="intro-text">It was the passage from the exhibition to the book dummy that taught me this: in the spreads, the portraits found themselves alongside forms, vegetal, mineral, geographical. The word line then showed its other side. A line is not only what separates: it is also what the world draws, a contour, a vein, a meander. There is in these forms a gratuitous beauty, which proves nothing and serves no purpose. This proximity does not compare: it shows the same gaze at work, held here by a face, there by a fold of the world.</p>
        <p class="intro-text">This project is my first: the first time I sought to make my images into a whole, to give form to what had, until then, only accumulated. It is built in reverse, the thread came after the photographs, and that may be its most exact truth. I did not decide to photograph borders. Looking back, I realized I had photographed nothing else: lines that separate, lines that draw.</p>
        <a class="see-images" href="#serie"></a>
        <hr class="horizon intro-proj-horizon" />
      </div>
    </div>

  </section>

  <!-- ── Série photographique ──────────────────────────────── -->
  <div class="series" id="serie">
    {spreads.map((spread) => (
      <>
        <div class={`spread spread--${spread.type} rv`}>
          {spread.photos.map((photo) => (
            <figure class={photo.figClass}>
              <img
                src={photo.src}
                data-full={photo.full}
                alt={`Spilling Beyond the Lines · photo ${photo.n}`}
                loading="lazy"
              />
            </figure>
          ))}
        </div>
        {spread.caption && (
          <p class="series-caption rv" set:html={spread.caption} />
        )}
      </>
    ))}
  </div>

  <!-- ── Crédits ─────────────────────────────────────────── -->
  <div class="project-credits">
    <div class="group">
      <div class="label">Credits</div>
      <p>Images reproduced with the kind permission of Diana Ferreira and Giovane Marquez.</p>
    </div>
  </div>

  <!-- ── Projet suivant ─────────────────────────────────────── -->
  <NextProject current="spilling-beyond-the-lines" />

</Layout>

<style is:global>

  /* ── Intro : colonnes épigraphe + projet ────────────────────── */
  .intro-epi {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
  }

  .intro-proj {
    flex: 1.05 1 0;
    display: flex;
    flex-direction: column;
  }

  .intro-proj-horizon {
    margin-top: auto;
  }

  /* ── Série : position relative nécessaire pour les recadrages ── */
  .spread figure { position: relative; }

  /* Cadrage forcé 3:2 (photos 47–48) */
  figure.land-crop {
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }
  figure.land-crop img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Cadrage forcé 2:3 portrait (photo 21) */
  figure.port-crop {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    position: relative;
  }
  figure.port-crop img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 90% center;
  }

  /* ── Mobile ───────────────────────────────────────── */
  @media (max-width: 700px) {
    .intro { flex-direction: column; }
  }

</style>

<script>
  // Justified row layout — equal-height rows, proportional widths
  function justify() {
    const mob = window.innerWidth <= 700;
    document.querySelectorAll<HTMLElement>('.spread--row').forEach(row => {
      const figs = Array.from(row.querySelectorAll<HTMLElement>('figure'));
      const imgs = figs.map(f => f.querySelector<HTMLImageElement>('img')!);
      const getR = (im: HTMLImageElement, fig: HTMLElement) => {
        if (fig.classList.contains('land-crop')) return 3 / 2;
        if (fig.classList.contains('port-crop')) return 2 / 3;
        return (im.naturalWidth && im.naturalHeight) ? im.naturalWidth / im.naturalHeight : 1;
      };
      function apply() {
        if (mob && figs.length === 2) {
          const avail = row.clientWidth - 4;
          const r0 = getR(imgs[0], figs[0]), r1 = getR(imgs[1], figs[1]);
          const w0 = Math.round(r0 / (r0 + r1) * avail);
          figs[0].style.flex = `0 0 ${w0}px`;
          figs[1].style.flex = `0 0 ${avail - w0}px`;
          return;
        }
        if (mob && figs.length === 3) {
          const avail = row.clientWidth - 4;
          const r0 = getR(imgs[0], figs[0]), r1 = getR(imgs[1], figs[1]);
          const w0 = Math.round(r0 / (r0 + r1) * avail);
          figs[0].style.flex = `0 0 ${w0}px`;
          figs[1].style.flex = `0 0 ${avail - w0}px`;
          figs[2].style.flex = '0 0 100%';
          return;
        }
        if (mob && figs.length === 4) {
          const avail = row.clientWidth - 4;
          ([[0,1],[2,3]] as [number,number][]).forEach(([a,b]) => {
            const ra = getR(imgs[a], figs[a]), rb = getR(imgs[b], figs[b]);
            const wa = Math.round(ra / (ra + rb) * avail);
            figs[a].style.flex = `0 0 ${wa}px`;
            figs[b].style.flex = `0 0 ${avail - wa}px`;
          });
          return;
        }
        figs.forEach((fig, i) => {
          fig.style.flex = `${getR(imgs[i], fig).toFixed(4)} 1 0`;
        });
      }
      if (imgs.every(im => im.complete && im.naturalWidth)) apply();
      else imgs.forEach(im => im.addEventListener('load', apply));
    });
  }
  function layoutGalRows() {
    const mob = window.innerWidth <= 700;
    const H = parseFloat(getComputedStyle(document.body).getPropertyValue('--rowh')) || 380;
    document.querySelectorAll<HTMLElement>('.gal-cell--photo').forEach(cell => {
      const img = cell.querySelector<HTMLImageElement>('img');
      if (!img) return;
      function apply() {
        if (mob) { cell.style.width = ''; return; }
        const r = img!.naturalWidth && img!.naturalHeight ? img!.naturalWidth / img!.naturalHeight : 1;
        cell.style.width = Math.round(r * H) + 'px';
      }
      if (img.complete && img.naturalWidth) apply();
      else img.addEventListener('load', apply);
    });
  }
  justify();
  layoutGalRows();
  window.addEventListener('resize', () => { clearTimeout((window as any)._jt); (window as any)._jt = setTimeout(() => { justify(); layoutGalRows(); }, 150); });

  // Scroll reveal
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); } });
  }, { threshold: .06 });
  document.querySelectorAll('.rv').forEach(el => obs.observe(el));

</script>
