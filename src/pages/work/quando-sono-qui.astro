---
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/work-project.css';
import Citation from '../../components/Citation.astro';
import NextProject from '../../components/NextProject.astro';

const s = (file: string) => `/images/work/quando-sono-qui/${file}`;

type Photo = { src: string; n: number };
type Spread = {
  type: 'row' | 'single';
  photos: Photo[];
};

const p = (n: number): Photo => ({ src: s(`${n}.jpg`), n });

const spreads: Spread[] = [
  { type: 'row',    photos: [p(2), p(3), p(4)] },
  { type: 'single', photos: [p(5)] },
  { type: 'row',    photos: [p(6), p(7)] },
  { type: 'row',    photos: [p(8), p(9), p(10)] },
  { type: 'row',    photos: [p(11), p(12), p(13)] },
  { type: 'row',    photos: [p(14), p(15), { src: s('15 2.jpg'), n: 15 }, p(16)] },
  { type: 'single', photos: [p(17)] },
  { type: 'row',    photos: [p(18), p(19)] },
  { type: 'row',    photos: [p(20), p(21), p(22)] },
  { type: 'single', photos: [p(23)] },
];
---

<Layout
  title="Quando sono qui, non sono là · Laurie Di Francesco"
  description="Quando sono qui, non sono là · An intimate geography of presence and absence. Brazil · ongoing."
  image="/images/work/quando-cover.jpg"
  bodyClass="page-quando"
  lightHeader={false}
>

  <!-- ── Hero ──────────────────────────────────────────────── -->
  <section class="phero">
    <div class="phero-bg" aria-hidden="true">
      <img src="/images/work/quando-sono-qui/1.jpg" alt="" loading="eager" fetchpriority="high" />
    </div>
    <div class="phero-inner container">
      <p class="phero-eyebrow">Resignifying</p>
      <h1>Quando sono qui,<br /><strong>non sono là</strong></h1>
      <p class="phero-count" aria-live="polite"></p>
    </div>
  </section>

  <!-- ── Ouverture : gal-rows photo + citations ── -->
  <section class="gal-opening">

    <div class="gal-row rv">
      <figure class="gal-cell gal-cell--photo">
        <img src={s('0.jpg')} alt="" loading="lazy" />
      </figure>
      <div class="gal-cell gal-cell--cit">
        <Citation author="Plato · Republic, Book VII">
          But what if someone dragged them along a steep and harsh ascent against their
          will, and did not let go until they were dragged right into the sunlight? Would
          they not feel pain and discomfort? And if they walked towards the sun and their
          eyes suddenly filled with brilliant light, would they be able to see even one of
          those things that are now called true realities?
        </Citation>
        <Citation author="René Char · Feuillets d'Hypnos (169)" note="freely translated from the French">
          Lucidity is the wound closest to the sun.
        </Citation>
      </div>
    </div>

    <div class="gal-row rv">
      <div class="gal-cell gal-cell--cit">
        <Citation author="José Ramalho Neto · Galope Resante">
          A sombra que me move<br />
          Também me ilumina<br />
          Me leve nos cabelos<br />
          Me lave na piscina<br />
          Em cada ponto claro<br />
          Cometa que cai no mar<br />
          Em cada cor diferente<br />
          Que tente me clarear<br />
          É noite que vai chegar<br />
          É claro que é de manhã<br />
          É moça e anciã
        </Citation>
      </div>
      <figure class="gal-cell gal-cell--photo">
        <img src={s('1.jpg')} alt="" loading="lazy" />
      </figure>
    </div>

    <div class="gal-row rv">
      <div class="gal-cell gal-cell--text">
        <p class="opening-eyebrow">The project</p>
        <p class="opening-text">The title stayed in Italian. A sentence spoken in passing, about a double belonging become triple, since adopted as an echo of an identity made of many shores.</p>
        <p class="opening-text">In this project, the geographical shore becomes an inner shore.</p>
        <p class="opening-text">Everything ends in a cave. Chosen, this one, not endured: a protected natural site, its forms drawn by water and time, a place one enters as into an enveloping, fertile shelter. On its walls, rock paintings. Lines that look almost childlike, thousands of years old, protected now, and that no one would think of burning anymore.</p>
        <p class="opening-text">There is a deep, faraway territory, indigenous lands protected and defended. That is where the faces come from: dignity, anger, peace regained. There one meets an innocence, under the light of the cerrado, of the tropics, where the end of the day carries another density.</p>
        <p class="opening-text">For all of this, it was necessary to return: to find again the marks of a millennial past that nothing and no one has erased, to meet faces that express the cycles of a life, hindered first, freed after. One can always make something of what has been made of us.</p>
        <p class="opening-text">The series follows the movement of the allegory: shadows taken for the real, the descent, the fear that settles in, then the way out. It does not seek to prove and asks for nothing: it passes through.</p>
        <p class="opening-text">The question it raises is simple: how does one hold on, after a childhood in which the gaze of adults was a tribunal. These images do not answer by bearing witness. They are made from outside, by a gaze that no longer mistakes shadows for the real.</p>
        <p class="opening-text">To transfigure the real: that is where these images are made from. We have art in order not to die of the truth.</p>
        <a class="see-images" href="#serie"></a>
        <hr class="horizon" />
      </div>
    </div>

  </section>

  <!-- ── Série photographique ──────────────────────────────── -->
  <div class="series" id="serie">
    {spreads.map((spread) => (
      <div class={`spread spread--${spread.type} rv`}>
        {spread.photos.map((photo) => (
          <figure>
            <img
              src={photo.src}
              alt={`Quando sono qui, non sono là · ${photo.n}`}
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    ))}
  </div>

  <!-- ── Crédits ─────────────────────────────────────────── -->
  <div class="project-credits">
    <div class="group">
      <div class="label">Credits</div>
      <p>Image reproduced with the kind permission of Tatila Lyma.</p>
    </div>
  </div>

  <!-- ── Projet suivant ─────────────────────────────────────── -->
  <NextProject current="quando-sono-qui" />

</Layout>

<script>
  // Justified row layout — spreads
  function justify() {
    const mob = window.innerWidth <= 700;
    document.querySelectorAll<HTMLElement>('.spread--row').forEach(row => {
      const figs = Array.from(row.querySelectorAll<HTMLElement>('figure'));
      const imgs = figs.map(f => f.querySelector<HTMLImageElement>('img')!);
      const getR = (im: HTMLImageElement) =>
        (im.naturalWidth && im.naturalHeight) ? im.naturalWidth / im.naturalHeight : 1;
      function apply() {
        if (mob && figs.length === 2) {
          const avail = row.clientWidth - 4;
          const r0 = getR(imgs[0]), r1 = getR(imgs[1]);
          const w0 = Math.round(r0 / (r0 + r1) * avail);
          figs[0].style.flex = `0 0 ${w0}px`;
          figs[1].style.flex = `0 0 ${avail - w0}px`;
          return;
        }
        if (mob && figs.length === 3) {
          const avail = row.clientWidth - 4;
          const r0 = getR(imgs[0]), r1 = getR(imgs[1]);
          const w0 = Math.round(r0 / (r0 + r1) * avail);
          figs[0].style.flex = `0 0 ${w0}px`;
          figs[1].style.flex = `0 0 ${avail - w0}px`;
          figs[2].style.flex = '0 0 100%';
          return;
        }
        if (mob && figs.length === 4) {
          const avail = row.clientWidth - 4;
          ([[0,1],[2,3]] as [number,number][]).forEach(([a,b]) => {
            const ra = getR(imgs[a]), rb = getR(imgs[b]);
            const wa = Math.round(ra / (ra + rb) * avail);
            figs[a].style.flex = `0 0 ${wa}px`;
            figs[b].style.flex = `0 0 ${avail - wa}px`;
          });
          return;
        }
        imgs.forEach((im, i) => {
          figs[i].style.flex = `${getR(im).toFixed(4)} 1 0`;
        });
      }
      if (imgs.every(im => im.complete && im.naturalWidth)) apply();
      else imgs.forEach(im => im.addEventListener('load', apply));
    });
  }
  // Justified row layout — gal-rows
  function layoutGalRows() {
    const mob = window.innerWidth <= 700;
    const H = parseFloat(getComputedStyle(document.body).getPropertyValue('--rowh')) || 380;
    document.querySelectorAll<HTMLElement>('.gal-cell--photo').forEach(cell => {
      const img = cell.querySelector<HTMLImageElement>('img');
      if (!img) return;
      function apply() {
        if (mob) { cell.style.width = ''; return; }
        const r = img!.naturalWidth && img!.naturalHeight
          ? img!.naturalWidth / img!.naturalHeight : 1;
        cell.style.width = Math.round(r * H) + 'px';
      }
      if (img.complete && img.naturalWidth) apply();
      else img.addEventListener('load', apply);
    });
  }
  justify();
  layoutGalRows();
  window.addEventListener('resize', () => {
    clearTimeout((window as any)._jt);
    (window as any)._jt = setTimeout(() => { justify(); layoutGalRows(); }, 150);
  });

  // Scroll reveal
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
    });
  }, { threshold: .06 });
  document.querySelectorAll('.rv').forEach(el => obs.observe(el));

</script>
