---
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/work-project.css';
import Citation from '../../components/Citation.astro';
import NextProject from '../../components/NextProject.astro';

const files: Record<number, string> = {
  1:  'Slovenia_1.JPG',
  2:  'Slovenia_2.JPG',
  3:  'Slovenia_3.JPG',
  4:  'Slovenia_4.JPG',
  5:  'Slovenia_5.JPG',
  6:  'Slovenia_6.jpg',
  7:  'Slovenia_7.JPG',
  8:  'Slovenia_8.jpg',
  9:  'Slovenia_9.JPG',
  10: 'Slovenia_10.jpg',
  11: 'Slovenia_11.JPG',
};

const s = (n: number) => `/images/work/toward-the-blue/${files[n]}`;

type Photo = { src: string; n: number };
type Spread = {
  type: 'row' | 'single';
  photos: Photo[];
  caption?: string;
};

const spreads: Spread[] = [
  { type: 'single', photos: [{ src: s(3), n: 3 }] },
  { type: 'row',    photos: [{ src: s(4), n: 4 }, { src: s(5), n: 5 }, { src: s(6), n: 6 }] },
  { type: 'row',    photos: [{ src: s(7), n: 7 }, { src: s(8), n: 8 }] },
  { type: 'single', photos: [{ src: s(9), n: 9 }] },
  { type: 'row',    photos: [{ src: s(10), n: 10 }, { src: s(11), n: 11 }] },
];
---

<Layout
  title="Toward the Blue · Laurie Di Francesco"
  description="Toward the Blue · a photographic series by Laurie Di Francesco."
  image="/images/work/toward-the-blue-cover.jpg"
  bodyClass="page-toward"
  lightHeader={false}
>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="phero">
    <div class="phero-bg" aria-hidden="true">
      <img
        src="/images/work/toward-the-blue/Slovenia_5.JPG"
        alt=""
        loading="eager"
      />
    </div>
    <div class="phero-inner container">
      <p class="phero-eyebrow">dreaming</p>
      <h1>Toward<br /><strong>the Blue</strong></h1>
    </div>
  </section>

  <!-- ── Ouverture : deux rangées photo + citation ── -->
  <section class="gal-opening">

    <div class="gal-row rv">
      <figure class="gal-cell gal-cell--photo">
        <img src={s(1)} alt="Toward the Blue · photo 1" loading="lazy" />
      </figure>
      <div class="gal-cell gal-cell--cit" data-ratio="0.75">
        <Citation author="Rainer Maria Rilke · Letters to a Young Poet" note="freely translated from the Brazilian edition">
          To look at things the way a child looks at something strange, from the
          depth of one's own world.
        </Citation>
        <Citation author="Friedrich Nietzsche · Thus Spoke Zarathustra" note="freely translated from the French edition">
          The child is innocence and forgetting, a new beginning, a game, a wheel
          rolling out of itself, a first movement, a sacred yes.
        </Citation>
      </div>
    </div>

    <div class="gal-row rv">
      <div class="gal-cell gal-cell--text" data-ratio="0.75">
        <p class="opening-eyebrow">The project</p>
        <p class="intro-text">The series opens on the gaze of a young girl and closes on the face of an adult woman. In between: stone dragons, a slide seen too close, panes of glass breaking the light apart, tarpaulins, reflections. Almost no nightmare. But the veil is there.</p>
        <p class="intro-text">The blue of the sky runs through this body of work as a conceptual operator. It is the same from one end of the earth to the other, above wars as above games. Perhaps that is why it holds: it promises nothing, and it does not give way.</p>
        <p class="intro-text">This series belongs to the current of magical realism. A tropical gaze rather than a Brazilian one, the gaze of someone who lived in Latin America long enough for the marvellous to stop being an exception.</p>
        <p class="intro-text">There is indeed a passage here, from child to adult. But it does not tell how one grows up. It rewrites that passage where childhood was missing, and seeks to recover, after the fact, a lightness that never took place.</p>
        <p class="intro-text">In Nietzsche, the child does not come first. It comes after the camel's burden and after the lion's refusal.</p>
        <hr class="horizon intro-proj-horizon" />
      </div>
      <figure class="gal-cell gal-cell--photo">
        <img src={s(2)} alt="Toward the Blue · photo 2" loading="lazy" />
      </figure>
    </div>

  </section>

  <!-- ── Série photographique ──────────────────────────────── -->
  <div class="series">
    {spreads.map((spread) => (
      <>
        <div class={`spread spread--${spread.type} rv`}>
          {spread.photos.map((photo) => (
            <figure class={photo.figClass}>
              <img
                src={photo.src}
                data-full={photo.src}
                alt={`Toward the Blue · photo ${photo.n}`}
                loading="lazy"
              />
            </figure>
          ))}
        </div>
        {spread.caption && (
          <p class="series-caption rv">
            {spread.caption}
          </p>
        )}
      </>
    ))}
  </div>

  <!-- ── Crédits ─────────────────────────────────────────── -->
  <div class="project-credits">
    <div class="group">
      <div class="label">Credits &amp; thanks</div>
      <p>Images reproduced with the kind permission of Ana Valant and Tereza Kozinc — with thanks to Tereza and to Klavdij Sluban, who put the right words to the way I see.</p>
    </div>
  </div>

  <!-- ── Projet suivant ─────────────────────────────────────── -->
  <NextProject current="toward-the-blue" />

</Layout>

<script>
  // Justified row layout
  function justify() {
    const mob = window.innerWidth <= 700;
    document.querySelectorAll<HTMLElement>('.spread--row').forEach(row => {
      const figs = Array.from(row.querySelectorAll<HTMLElement>('figure'));
      const imgs = figs.map(f => f.querySelector('img') as HTMLImageElement);
      function apply() {
        if (mob) { figs.forEach(f => { f.style.flexGrow = ''; }); return; }
        const asp = imgs.map(im =>
          (im.naturalWidth && im.naturalHeight) ? im.naturalWidth / im.naturalHeight : 1
        );
        figs.forEach((f, i) => { f.style.flexGrow = asp[i].toFixed(4); });
      }
      if (imgs.every(im => im.complete && im.naturalWidth)) apply();
      else imgs.forEach(im => im.addEventListener('load', apply));
    });
  }
  // Justified row layout — gal-rows
  function justifyGalRows() {
    const mob = window.innerWidth <= 700;
    document.querySelectorAll<HTMLElement>('.gal-cell--photo').forEach(cell => {
      const img = cell.querySelector<HTMLImageElement>('img');
      if (!img) return;
      function apply() {
        if (mob) { cell.style.flexGrow = ''; return; }
        const r = img!.naturalWidth && img!.naturalHeight
          ? img!.naturalWidth / img!.naturalHeight : 1;
        cell.style.flexGrow = r.toFixed(4);
      }
      if (img.complete && img.naturalWidth) apply();
      else img.addEventListener('load', apply);
    });
  }
  justify();
  justifyGalRows();
  window.addEventListener('resize', () => {
    clearTimeout((window as any)._jt);
    (window as any)._jt = setTimeout(() => { justify(); justifyGalRows(); }, 150);
  });

  // Scroll reveal
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
    });
  }, { threshold: .06 });
  document.querySelectorAll('.rv').forEach(el => obs.observe(el));

</script>
