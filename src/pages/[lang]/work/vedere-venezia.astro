---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/pages/work-project.css';
import Citation from '../../../components/Citation.astro';
import NextProject from '../../../components/NextProject.astro';
import { ui, type Lang } from '../../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'pt' } },
  ];
}

const { lang } = Astro.params;
const t = ui[lang as Lang];

const s = (file: string) => `/images/work/vedere-venezia/${file}`;
type Photo = { src: string; n: number };
type Spread = { type: 'row' | 'single'; photos: Photo[] };
const p = (n: number): Photo => ({ src: s(`${n}.jpg`), n });

const content = {
  fr: {
    aznavourPoem: `Que c'est triste Venise<br />Le soir sur la lagune<br />Quand on cherche une main<br />Que l'on ne vous tend pas<br />Et que l'on ironise<br />Devant le clair de lune<br />Pour tenter d'oublier<br />Ce que l'on ne se dit pas`,
    dufourmantelle: `Se séparer, ainsi, c'est commencer à traduire. C'est trouver ne serait-ce qu'un mot pour traduire ce qui en soi fait signe et sens dans une langue nouvelle afin qu'elle soit audible pour un autre. C'est quitter la langue maternelle pour risquer sa propre langue, la langue poétique par excellence.`,
    projectLabel: 'Le Projet',
    projectText: [
      `Le titre retourne un proverbe. Voir Venise et mourir : la beauté comme achèvement, le lieu où l'on peut s'arrêter. Ici, il s'agit de la traverser et de continuer.`,
      `La série commence par un enfant sous un parapluie à motifs de cœurs. Elle passe par la nuit et revient au jour, comme une nécessité de renaître.`,
      `Venise est un lieu de mémoire familiale, et il fallait le traverser à nouveau, seule, pour en faire autre chose.`,
      `L'avant-dernière image superpose deux temporalités : une photographie d'archive familiale, et une image faite au téléphone à l'instant précis où le retour dans ce lieu chargé prenait fin. Le point de départ du projet et le point de sortie coïncident en une seule image, comme s'il fallait enfin poser un point final. Une séparation nécessaire, dont il ne reste ici que la signalétique.`,
      `De cette coïncidence naît une dernière figure, dans un reflet de vitrine. Quelque chose de Gelsomina, chez Fellini : l'émerveillement qui traverse la brutalité sans en être défait. Non pas la naïveté d'avant, mais l'innocence comme conquête, celle qui vient après. C'est la figure du lion qui devient enfant, chez Nietzsche, et elle revient d'un projet à l'autre.`,
    ],
  },
  it: {
    aznavourPoem: `Com'è triste Venezia<br />La sera sulla laguna<br />Quando si cerca una mano<br />Che non ci viene tesa<br />E si ironizza<br />Davanti al chiaro di luna<br />Per tentare di dimenticare<br />Ciò che non ci si dice`,
    dufourmantelle: `Separarsi, così, è cominciare a tradurre. È trovare almeno una parola per tradurre ciò che in sé fa segno e senso in una lingua nuova affinché sia audibile per un altro. È lasciare la lingua materna per rischiare la propria lingua, la lingua poetica per eccellenza.`,
    tradfr: 'traduzione libera dal francese',
    projectLabel: 'Il Progetto',
    projectText: [
      `Il titolo rovescia un proverbio. Vedere Venezia e poi morire: la bellezza come compimento, il luogo dove ci si può fermare. Qui si tratta di attraversarla e di proseguire.`,
      `La serie comincia con un bambino sotto un ombrello a cuori. Passa per la notte e torna al giorno, come una necessità di rinascere.`,
      `Venezia è un luogo di memoria familiare, e bisognava attraversarlo di nuovo, da sola, per farne altro.`,
      `La penultima immagine sovrappone due temporalità: una fotografia d'archivio familiare, e un'immagine scattata col telefono nell'istante preciso in cui il ritorno in quel luogo carico stava finendo. Il punto di partenza del progetto e il punto di uscita coincidono in una sola immagine, come se finalmente si dovesse mettere un punto fermo. Una separazione necessaria, di cui qui non resta che la segnaletica.`,
      `Da questa coincidenza nasce un'ultima figura, in un riflesso di vetrina. Qualcosa di Gelsomina, in Fellini: la meraviglia che attraversa la brutalità senza esserne disfatta. Non l'ingenuità di prima, ma l'innocenza come conquista, quella che viene dopo. È la figura del leone che diventa bambino, in Nietzsche, e ritorna da un progetto all'altro.`,
    ],
  },
  pt: {
    aznavourPoem: `Como é triste Veneza<br />À tarde na laguna<br />Quando se procura uma mão<br />Que não nos é estendida<br />E faz-se ironia<br />Perante o luar<br />Para tentar esquecer<br />O que não nos dizemos`,
    dufourmantelle: `Separar-se, assim, é começar a traduzir. É encontrar ao menos uma palavra para traduzir o que em si faz signo e sentido numa língua nova para que seja audível para o outro. É abandonar a língua materna para arriscar a sua própria língua, a língua poética por excelência.`,
    tradfr: 'tradução livre do francês',
    projectLabel: 'O Projeto',
    projectText: [
      `O título inverte um provérbio. Ver Veneza e morrer: a beleza como conclusão, o lugar onde se pode parar. Aqui, trata-se de atravessá-la e seguir adiante.`,
      `A série começa com uma criança sob um guarda-chuva estampado de corações. Passa pela noite e volta ao dia, como uma necessidade de renascer.`,
      `Veneza é um lugar de memória familiar, e era preciso atravessá-lo de novo, sozinha, para fazer dele outra coisa.`,
      `A penúltima imagem sobrepõe duas temporalidades: uma fotografia de arquivo familiar, e uma imagem feita no celular no instante exato em que o retorno àquele lugar carregado chegava ao fim. O ponto de partida do projeto e o ponto de saída coincidem numa única imagem, como se enfim fosse preciso pôr um ponto final. Uma separação necessária, da qual aqui resta apenas a sinalização.`,
      `Dessa coincidência nasce uma última figura, num reflexo de vitrine. Algo de Gelsomina, em Fellini: o encantamento que atravessa a brutalidade sem ser desfeito por ela. Não a ingenuidade de antes, mas a inocência como conquista, aquela que vem depois. É a figura do leão que se torna criança, em Nietzsche, e que retorna de um projeto a outro.`,
    ],
  },
}[lang as 'fr' | 'it' | 'pt'];

const spreads: Spread[] = [
  { type: 'single', photos: [p(3)] },
  { type: 'row',    photos: [p(4), p(5)] },
  { type: 'row',    photos: [p(6), p(7), p(8)] },
  { type: 'single', photos: [p(9)] },
  { type: 'row',    photos: [p(10), p(11)] },
  { type: 'single', photos: [p(12)] },
];
---

<Layout
  title="Vedere Venezia e Non Morire · Laurie Di Francesco"
  description="Vedere Venezia e Non Morire · Seeing Venice without dying from it."
  image="/images/work/vedere-venezia-cover.jpg"
  lang={lang}
  bodyClass="page-venezia"
  lightHeader={false}
>

  <!-- ── Hero ──────────────────────────────────────────────── -->
  <section class="phero">
    <div class="phero-bg" aria-hidden="true">
      <img src="/images/work/vedere-venezia/7.jpg" alt="" loading="eager" />
    </div>
    <div class="phero-inner container">
      <p class="phero-eyebrow">{t.home.projects[3].cerule}</p>
      <h1>Vedere Venezia<br /><strong>e Non Morire</strong></h1>
      <p class="phero-count" aria-live="polite"></p>
    </div>
  </section>

  <!-- ── Épigraphes ──────────────────────────────────────────── -->
  <section class="gal-opening">

    <div class="gal-row rv">
      <figure class="gal-cell gal-cell--photo">
        <img src={s('1.jpg')} alt="" loading="lazy" />
      </figure>
      <div class="gal-cell gal-cell--cit">
        <Citation
          author="Charles Aznavour · Que c'est triste Venise"
          note={('tradfr' in content) ? (content as any).tradfr : undefined}
        >
          <Fragment set:html={content.aznavourPoem} />
        </Citation>
      </div>
    </div>

    <div class="gal-row rv">
      <div class="gal-cell gal-cell--cit">
        <Citation
          author="Anne Dufourmantelle"
          note={('tradfr' in content) ? (content as any).tradfr : undefined}
        >
          <Fragment set:html={content.dufourmantelle} />
        </Citation>
      </div>
      <figure class="gal-cell gal-cell--photo">
        <img src={s('2.jpg')} alt="" loading="lazy" />
      </figure>
    </div>

    <div class="gal-row rv">
      <div class="gal-cell gal-cell--text">
        <p class="opening-eyebrow">{content.projectLabel}</p>
        {content.projectText.map((para) => (
          <p class="opening-text">{para}</p>
        ))}
        <a class="see-images" href="#serie"></a>
        <hr class="horizon" />
      </div>
    </div>

  </section>

  <!-- ── Série photographique ──────────────────────────────── -->
  {spreads.length > 0 && (
    <div class="series vv-series" id="serie">
      {spreads.map((spread) => (
        <div class={`spread spread--${spread.type} rv`}>
          {spread.photos.map((photo) => (
            <figure>
              <img src={photo.src} alt={`Vedere Venezia e Non Morire · ${photo.n}`} loading="lazy" />
            </figure>
          ))}
        </div>
      ))}
    </div>
  )}

  <!-- ── Projet suivant ─────────────────────────────────────── -->
  <NextProject current="vedere-venezia" lang={lang} label={t.work.nextProject} />

</Layout>

<script>
  function justify() {
    const mob = window.innerWidth <= 700;
    document.querySelectorAll<HTMLElement>('.spread--row').forEach(row => {
      const figs = Array.from(row.querySelectorAll<HTMLElement>('figure'));
      const imgs = figs.map(f => f.querySelector<HTMLImageElement>('img')!);
      const getR = (im: HTMLImageElement) =>
        (im.naturalWidth && im.naturalHeight) ? im.naturalWidth / im.naturalHeight : 1;
      function apply() {
        if (mob && figs.length === 2) {
          const avail = row.clientWidth - 4;
          const r0 = getR(imgs[0]), r1 = getR(imgs[1]);
          const w0 = Math.round(r0 / (r0 + r1) * avail);
          figs[0].style.flex = `0 0 ${w0}px`;
          figs[1].style.flex = `0 0 ${avail - w0}px`;
          return;
        }
        if (mob && figs.length === 3) {
          const avail = row.clientWidth - 4;
          const r0 = getR(imgs[0]), r1 = getR(imgs[1]);
          const w0 = Math.round(r0 / (r0 + r1) * avail);
          figs[0].style.flex = `0 0 ${w0}px`;
          figs[1].style.flex = `0 0 ${avail - w0}px`;
          figs[2].style.flex = '0 0 100%';
          return;
        }
        if (mob && figs.length === 4) {
          const avail = row.clientWidth - 4;
          ([[0,1],[2,3]] as [number,number][]).forEach(([a,b]) => {
            const ra = getR(imgs[a]), rb = getR(imgs[b]);
            const wa = Math.round(ra / (ra + rb) * avail);
            figs[a].style.flex = `0 0 ${wa}px`;
            figs[b].style.flex = `0 0 ${avail - wa}px`;
          });
          return;
        }
        imgs.forEach((im, i) => {
          figs[i].style.flex = `${getR(im).toFixed(4)} 1 0`;
        });
      }
      if (imgs.every(im => im.complete && im.naturalWidth)) apply();
      else imgs.forEach(im => im.addEventListener('load', apply));
    });
  }
  function layoutGalRows() {
    const mob = window.innerWidth <= 700;
    const H = parseFloat(getComputedStyle(document.body).getPropertyValue('--rowh')) || 380;
    document.querySelectorAll<HTMLElement>('.gal-cell--photo').forEach(cell => {
      const img = cell.querySelector<HTMLImageElement>('img');
      if (!img) return;
      function apply() {
        if (mob) { cell.style.width = ''; return; }
        const r = img!.naturalWidth && img!.naturalHeight
          ? img!.naturalWidth / img!.naturalHeight : 1;
        cell.style.width = Math.round(r * H) + 'px';
      }
      if (img.complete && img.naturalWidth) apply();
      else img.addEventListener('load', apply);
    });
  }
  justify();
  layoutGalRows();
  window.addEventListener('resize', () => {
    clearTimeout((window as any)._jt);
    (window as any)._jt = setTimeout(() => { justify(); layoutGalRows(); }, 150);
  });

  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); } });
  }, { threshold: .06 });
  document.querySelectorAll('.rv').forEach(el => obs.observe(el));

</script>
