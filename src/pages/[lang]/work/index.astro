---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/pages/work-index.css';
import Citation from '../../../components/Citation.astro';
import { ui, type Lang } from '../../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'pt' } },
  ];
}

const { lang } = Astro.params;
const t = ui[lang as Lang];

const accentTokens = [
  'var(--acc-quando)',
  'var(--acc-toward)',
  'var(--acc-ecm)',
  'var(--acc-venezia)',
  'var(--acc-spill)',
];

const laMerEnCorps = {
  href: `/${lang}/work/la-mer-en-corps`,
  title: 'La Mer en Corps',
  cerule: t.work.laMerCerule,
  image: '/images/work/la-mer-en-corps-cover.jpg',
  accent: 'var(--acc-lmec)',
};

const projects = t.home.projects.map((p, i) => {
  const slugs = [
    'quando-sono-qui',
    'toward-the-blue',
    'en-corps-en-la-mer',
    'vedere-venezia',
    'spilling-beyond-the-lines',
  ];
  const titles = [
    'Quando sono qui, non sono là',
    'Toward the Blue',
    'En Corps à la Mer',
    'Vedere Venezia e Non Morire',
    t.work.spillingTitle,
  ];
  const images = [
    '/images/work/quando-cover.jpg',
    '/images/work/toward-the-blue-cover.jpg',
    '/images/work/en-corps-cover.jpg',
    '/images/work/vedere-venezia-cover.jpg',
    '/images/work/spilling-cover.jpg',
  ];
  return {
    href: `/${lang}/work/${slugs[i]}`,
    title: titles[i],
    cerule: p.cerule,
    image: images[i],
    accent: accentTokens[i],
  };
});
---

<Layout
  title={t.work.h1}
  description={`${t.work.h1} · Laurie Di Francesco`}
  lang={lang}
>

  <!-- ── Page head ────────────────────────────── -->
  <section class="wi-head container">
    <p class="wi-eyebrow">{t.nav.work}</p>
    <h1 class="wi-h1">{t.work.h1}</h1>

    <Citation author={t.work.quoteCite} justify>
      <Fragment set:html={t.work.quoteHtml} />
    </Citation>
  </section>

  <div class="wi-projects">

  <!-- ════════════════════════════════════════════
    01 · QUANDO SONO QUI
  ═════════════════════════════════════════════ -->
  <section class="p1">
    <div class="proj-head">
      <span class="wi-cerule">{projects[0].cerule}</span>
      <h2 class="wi-title" set:html="Quando&nbsp;sono&nbsp;qui, non&nbsp;sono&nbsp;là" />
    </div>
    <div class="p1-img-wrap">
      <a class="proj-img" href={projects[0].href} style={`--veil-color: ${projects[0].accent}`}>
        <img src={projects[0].image} alt={projects[0].title} loading="lazy" />
        <div class="proj-veil" aria-hidden="true">
          <span class="proj-veil-cerule">{projects[0].cerule}</span>
          <p class="proj-veil-title">{projects[0].title}</p>
        </div>
      </a>
    </div>
  </section>

  <hr class="proj-sep" />

  <!-- ════════════════════════════════════════════
    06 · LA MER EN CORPS
  ═════════════════════════════════════════════ -->
  <section class="p6">
    <div class="proj-head">
      <span class="wi-cerule">{laMerEnCorps.cerule}</span>
      <h2 class="wi-title">{laMerEnCorps.title}</h2>
    </div>
    <div class="p6-img-wrap">
      <a class="proj-img" href={laMerEnCorps.href} style={`--veil-color: ${laMerEnCorps.accent}`}>
        <img src={laMerEnCorps.image} alt={laMerEnCorps.title} loading="lazy" />
        <div class="proj-veil" aria-hidden="true">
          <span class="proj-veil-cerule">{laMerEnCorps.cerule}</span>
          <p class="proj-veil-title">{laMerEnCorps.title}</p>
        </div>
      </a>
    </div>
  </section>

  <div class="proj-section-divider">
    <hr />
    <p class="proj-section-divider-label">{t.home.previousWorks}</p>
  </div>

  <!-- ════════════════════════════════════════════
    02 · TOWARD THE BLUE
  ═════════════════════════════════════════════ -->
  <section class="p2">
    <div class="p2-img-side">
      <a class="proj-img" href={projects[1].href} style={`--veil-color: ${projects[1].accent}`}>
        <img src={projects[1].image} alt={projects[1].title} loading="lazy" />
        <div class="proj-veil" aria-hidden="true">
          <span class="proj-veil-cerule">{projects[1].cerule}</span>
          <p class="proj-veil-title">{projects[1].title}</p>
        </div>
      </a>
    </div>
    <div class="p2-text-side">
      <span class="wi-cerule">{projects[1].cerule}</span>
      <h2 class="wi-title">{projects[1].title}</h2>
    </div>
  </section>

  <hr class="proj-sep" />

  <!-- ════════════════════════════════════════════
    03 · EN CORPS À LA MER
  ═════════════════════════════════════════════ -->
  <section class="p3">
    <a class="proj-img" href={projects[2].href} style={`--veil-color: ${projects[2].accent}`}>
      <img src={projects[2].image} alt={projects[2].title} loading="lazy" />
      <div class="proj-veil" aria-hidden="true">
        <span class="proj-veil-cerule">{projects[2].cerule}</span>
        <p class="proj-veil-title">{projects[2].title}</p>
      </div>
    </a>
    <div class="p3-meta">
      <span class="wi-cerule">{projects[2].cerule}</span>
      <h2 class="wi-title">{projects[2].title}</h2>
    </div>
  </section>

  <hr class="proj-sep" />

  <!-- ════════════════════════════════════════════
    04 · VEDERE VENEZIA
  ═════════════════════════════════════════════ -->
  <section class="p4">
    <div class="p4-img-row">
      <a class="proj-img" href={projects[3].href} style={`--veil-color: ${projects[3].accent}`}>
        <img src={projects[3].image} alt={projects[3].title} loading="lazy" />
        <div class="proj-veil" aria-hidden="true">
          <span class="proj-veil-cerule">{projects[3].cerule}</span>
          <p class="proj-veil-title">{projects[3].title}</p>
        </div>
      </a>
    </div>
    <div class="p4-below">
      <span class="wi-cerule">{projects[3].cerule}</span>
      <h2 class="p4-title-big">{projects[3].title}</h2>
    </div>
  </section>

  <hr class="proj-sep" />

  <!-- ════════════════════════════════════════════
    05 · SPILLING BEYOND THE LINES
  ═════════════════════════════════════════════ -->
  <section class="p5">
    <div class="p5-img-side">
      <a class="proj-img" href={projects[4].href} style={`--veil-color: ${projects[4].accent}`}>
        <img src={projects[4].image} alt={projects[4].title} loading="lazy" />
        <div class="proj-veil" aria-hidden="true">
          <span class="proj-veil-cerule">{projects[4].cerule}</span>
          <p class="proj-veil-title">{projects[4].title}</p>
        </div>
      </a>
    </div>
    <div class="p5-text-side">
      <span class="wi-cerule">{projects[4].cerule}</span>
      <h2 class="wi-title">{projects[4].title}</h2>
    </div>
  </section>


  </div><!-- /wi-projects -->

</Layout>
