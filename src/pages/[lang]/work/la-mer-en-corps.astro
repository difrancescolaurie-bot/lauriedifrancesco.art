---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/pages/work-project.css';
import { ui, type Lang } from '../../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'pt' } },
  ];
}

const { lang } = Astro.params;
const t = ui[lang as Lang];

const content = {
  fr: {
    eyebrow: 'Tracer',
    caption: "L'eau et les rêves pour donner corps au mouvement.<br />Un an de traversées.",
    bq1: "La mer n'est pas un corps qu'on voit, pas même un corps qu'on étreint. C'est un milieu dynamique qui répond à la dynamique de nos offenses.",
    bq2Long: "Si le regard des choses est un peu doux, un peu grave, un peu pensif, c'est un regard de l'eau. L'examen de l'imagination nous conduit à ce paradoxe : dans l'imagination de la vision généralisée, l'eau joue un rôle inattendu. L'œil véritable de la terre, c'est l'eau. Dans nos yeux, c'est l'eau qui rêve. Nos yeux ne sont-ils pas « cette flaque inexplorée de lumière liquide que Dieu a mise au fond de nous-mêmes » ? Dans la nature, c'est encore l'eau qui voit, c'est encore l'eau qui rêve.",
    bq2Short: "L'œil véritable de la terre, c'est l'eau. Dans nos yeux, c'est l'eau qui rêve.",
    bachelardCite: "Gaston Bachelard — L'Eau et les Rêves",
    bachelardTransl: null,
    sectionTitle: 'Le Projet',
    p1: "<em>En Corps à la Mer</em> s'achevait là où le corps retrouvait l'eau. <em>La Mer en Corps</em> commence un an plus tard, à l'autre bout de ce geste : cinquante-trois nages le long de la côte, d'août 2025 à juillet 2026.",
    p2: "Un corps qui avait cédé, revenant à la même eau jusqu'à ce que quelque chose en lui change de forme. Pas une guérison. Plutôt ce qu'on se dit quand on ne va pas encore bien mais qu'on ne peut pas s'effondrer : rien n'est définitif. <span class=\"k\">On répète le mouvement pour se tenir, et un jour le mouvement et l'eau vous tiennent à leur tour.</span>",
    clementineIntro: "En concert, le musicien Benjamin Clementine arrête la musique et fait répéter cette phrase par la salle, jusqu'à ce que la phrase porte ceux qui la portent.",
    clementineBq: "La répétition ne consiste pas toujours à dire deux fois la même chose. Parfois, c'est revenir à une blessure jusqu'à ce qu'elle change de forme.",
    p3: "Près de cinquante mille mouvements de bras. Une eau de quatorze à vingt-sept degrés. Un cœur à cent trente-sept. L'année est enregistrée par une montre à mon poignet, un point par seconde : latitude, longitude, température, pouls.",
    p4: "C'est ce qui m'intéresse ici. La nage prend tout : pas de main libre, pas d'œil libre, aucune distance avec le sujet. <span class=\"k\">Souvent je me retrouve immergée dans un bleu profond, exactement le même bleu que le ciel un jour pur, beau : mes repères et mon sens de l'orientation disparaissent.</span>",
    p5: "L'enregistrement est donc délégué. D'un côté, les outils les plus connectés qui soient : une constellation de satellites, un capteur à mon poignet, un algorithme qui transforme une année de positions en dessin. De l'autre, les plus anciens et les plus bricolés : une pellicule, un appareil scellé dans une pochette étanche pour téléphone, attachée à la bouée. Aucun des deux ne me rend le contrôle. Le premier enregistre sans moi ; le second laisse entrer le sel, les reflets, et ce que la houle décide.",
    p6: "Ce qui revient, ce sont des données, des pixels, de l'argentique exposé, et le plus souvent des tentatives à l'aveugle, avant que quoi que ce soit devienne une photographie. <span class=\"k\">J'ai cessé de traiter cet aveuglement comme un échec. C'est une condition du travail : à cette distance du rivage, les deux bras pris, le hasard n'est pas ce qui abîme l'image, c'est ce qui la fait.</span> Ramener tout cela à une image, c'est repasser par chacun des outils qui l'ont produite, de l'algorithme à la cuve de développement. Je n'ai voulu en laisser aucun hors du cadre.",
    p7: "Superposées, les cinquante-trois traces ne décrivent plus un lieu. Chacune est ramenée à son propre centre ; le rivage disparaît, il ne reste que le geste. Ce qui brille le plus est ce qui a été le plus répété.",
    p8: "L'année se referme sur une boucle. En musique, une boucle est un fragment sonore rejoué en continu, sans rupture perceptible. En mer, c'est une figure qui s'achève sur la rive où elle a commencé. Mais on ne revient jamais d'une nage identique : le corps qui termine cette année n'est pas celui qui l'a commencée. <span class=\"k\">Vue de côté, la boucle était depuis le début une spirale qui monte.</span>",
  },
  it: {
    eyebrow: 'Tracciare',
    caption: "L'acqua e i sogni per dare corpo al movimento.<br />Un anno di traversate.",
    bq1: "Il mare non è un corpo che si vede, e nemmeno un corpo che si abbraccia. È un mezzo dinamico che risponde alla dinamica delle nostre offese.",
    bq2Long: "Se lo sguardo delle cose è un poco dolce, un poco grave, un poco pensoso, è uno sguardo d'acqua. L'esame dell'immaginazione ci conduce a questo paradosso: nell'immaginazione della visione generalizzata, l'acqua ha un ruolo inatteso. Il vero occhio della terra è l'acqua. Nei nostri occhi, è l'acqua che sogna. I nostri occhi non sono forse «quella pozza inesplorata di luce liquida che Dio ha posto in fondo a noi stessi»? In natura, è ancora l'acqua che vede, è ancora l'acqua che sogna.",
    bq2Short: "Il vero occhio della terra è l'acqua. Nei nostri occhi, è l'acqua che sogna.",
    bachelardCite: "Gaston Bachelard — L'Eau et les Rêves",
    bachelardTransl: "traduzione libera dal francese",
    sectionTitle: 'Il Progetto',
    p1: "<em>En Corps à la Mer</em> finiva là dove il corpo ritrovava l'acqua. <em>La Mer en Corps</em> comincia un anno dopo, all'altro capo di quel gesto: cinquantatré nuotate lungo la costa, da agosto 2025 a luglio 2026.",
    p2: "Un corpo che aveva ceduto, tornando alla stessa acqua finché qualcosa in lui non ha cambiato forma. Non una guarigione. Piuttosto quello che ci si dice quando non si sta ancora bene ma non ci si può permettere di crollare: niente è definitivo. <span class=\"k\">Si ripete il movimento per reggersi, e un giorno il movimento e l'acqua ti reggono a loro volta.</span>",
    clementineIntro: "Dal vivo, il musicista Benjamin Clementine ferma la musica e fa ripetere quella frase alla sala, finché la frase sorregge chi la sorregge.",
    clementineBq: "La ripetizione non è sempre dire due volte la stessa cosa. A volte è tornare a una ferita finché non cambia forma.",
    p3: "Quasi cinquantamila bracciate. Un'acqua dai quattordici ai ventisette gradi. Un cuore a centotrentasette. L'anno è registrato da un orologio al polso, un punto al secondo: latitudine, longitudine, temperatura, battito.",
    p4: "È questo che mi interessa qui. Nuotare prende tutto: nessuna mano libera, nessun occhio libero, nessuna distanza dal soggetto. <span class=\"k\">Molte volte mi ritrovo immersa in un blu profondo, esattamente lo stesso blu del cielo in una giornata limpida: i miei punti di riferimento e il senso dell'orientamento svaniscono.</span>",
    p5: "La registrazione viene quindi affidata ad altro. Da una parte, gli strumenti più connessi che esistano: una costellazione di satelliti, un sensore al polso, un algoritmo che trasforma un anno di posizioni in un disegno. Dall'altra, i più antichi e i più improvvisati: un rullino, una macchina fotografica sigillata in una custodia impermeabile da telefono, legata alla boa. Nessuno dei due mi restituisce il controllo. Il primo registra senza di me; il secondo lascia entrare il sale, i riflessi, e ciò che decide l'onda.",
    p6: "Quello che torna indietro sono dati, pixel, argento esposto, e il più delle volte tentativi alla cieca, prima che qualcosa diventi una fotografia. <span class=\"k\">Ho smesso di considerare quella cecità un fallimento. È una condizione del lavoro: a quella distanza dalla riva, con entrambe le braccia occupate, il caso non è ciò che rovina l'immagine, è ciò che la fa.</span> Riportare tutto questo a un'immagine significa ripassare da ogni strumento che l'ha prodotta, dall'algoritmo alla vaschetta di sviluppo. Non ho voluto lasciarne nessuno fuori dall'inquadratura.",
    p7: "Sovrapposte, le cinquantatré tracce non descrivono più un luogo. Ognuna è riportata al proprio centro; la riva scompare, resta solo il gesto. Ciò che brilla di più è ciò che è stato ripetuto di più.",
    p8: "L'anno si chiude su un loop. In musica, un loop è un frammento sonoro riprodotto di continuo, senza stacchi percepibili. In mare, è una figura che finisce sulla riva da cui è partita. Ma da una nuotata non si torna mai uguali: il corpo che finisce quest'anno non è quello che l'ha cominciato. <span class=\"k\">Visto di lato, il loop era da sempre una spirale che sale.</span>",
  },
  pt: {
    eyebrow: 'Traçando',
    caption: "A água e os sonhos para dar corpo ao movimento.<br />Um ano de travessias.",
    bq1: "O mar não é um corpo que se vê, nem sequer um corpo que se abraça. É um meio dinâmico que responde à dinâmica das nossas ofensas.",
    bq2Long: "Se o olhar das coisas é um pouco doce, um pouco grave, um pouco pensativo, é um olhar de água. O exame da imaginação nos conduz a este paradoxo: na imaginação da visão generalizada, a água tem um papel inesperado. O verdadeiro olho da terra é a água. Em nossos olhos, é a água que sonha. Não serão nossos olhos «aquela poça inexplorada de luz líquida que Deus pôs no fundo de nós mesmos»? Na natureza, é ainda a água que vê, é ainda a água que sonha.",
    bq2Short: "O verdadeiro olho da terra é a água. Em nossos olhos, é a água que sonha.",
    bachelardCite: "Gaston Bachelard — L'Eau et les Rêves",
    bachelardTransl: "tradução livre do francês",
    sectionTitle: 'O Projeto',
    p1: "<em>En Corps à la Mer</em> terminava onde o corpo reencontrava a água. <em>La Mer en Corps</em> começa um ano depois, na outra ponta desse gesto: cinquenta e três travessias ao longo da costa, de agosto de 2025 a julho de 2026.",
    p2: "Um corpo que havia cedido, voltando à mesma água até que algo nele mudasse de forma. Não é cura. É mais próximo do que alguém diz a si mesmo quando ainda não está bem mas não pode desabar: nada é definitivo. <span class=\"k\">A gente repete o movimento para se sustentar, e um dia o movimento e a água sustentam a gente de volta.</span>",
    clementineIntro: "Nos shows, o músico Benjamin Clementine para a música e faz a plateia repetir essa frase, até que a frase sustente quem a sustenta.",
    clementineBq: "Repetir nem sempre é dizer duas vezes a mesma coisa. Às vezes é voltar a uma ferida até que ela mude de forma.",
    p3: "Quase cinquenta mil braçadas. Água de quatorze a vinte e sete graus. Um coração a cento e trinta e sete. O ano é registrado por um relógio no meu pulso, um ponto por segundo: latitude, longitude, temperatura, pulsação.",
    p4: "É isso que me interessa aqui. Nadar toma tudo: nenhuma mão livre, nenhum olho livre, nenhuma distância do assunto. <span class=\"k\">Muitas vezes me encontro imersa num azul profundo, exatamente o mesmo azul do céu num dia limpo: minhas referências e meu senso de direção desaparecem.</span>",
    p5: "O registro é então entregue a outra coisa. De um lado, as ferramentas mais conectadas que existem: uma constelação de satélites, um sensor no pulso, um algoritmo que transforma um ano de posições num desenho. Do outro, as mais antigas e as mais improvisadas: um rolo de filme, uma câmera lacrada dentro de uma capa impermeável de celular, amarrada à boia. Nenhuma das duas me devolve o controle. A primeira registra sem mim; a segunda deixa entrar o sal, o reflexo e o que a ondulação decidir.",
    p6: "O que volta são dados, pixels, prata exposta, e na maior parte do tempo tentativas às cegas, antes que qualquer coisa vire uma fotografia. <span class=\"k\">Parei de tratar essa cegueira como fracasso. É uma condição do trabalho: àquela distância da margem, com os dois braços ocupados, o acaso não é o que estraga a imagem, é o que a faz.</span> Transformar tudo isso em imagem significa passar de novo por cada ferramenta que a produziu, do algoritmo ao tanque de revelação. Não quis deixar nenhuma delas fora do quadro.",
    p7: "Sobrepostos, os cinquenta e três traçados já não descrevem um lugar. Cada um é trazido ao seu próprio centro; a margem desaparece e resta apenas o gesto. O que brilha mais forte é o que foi mais repetido.",
    p8: "O ano se fecha num loop. Na música, um loop é um trecho sonoro repetido continuamente, sem corte perceptível. No mar, é uma figura que termina na margem onde começou. Mas nunca se volta de um mergulho igual: o corpo que termina este ano não é o que o começou. <span class=\"k\">Visto de lado, o loop sempre foi uma espiral que sobe.</span>",
  },
}[lang as 'fr' | 'it' | 'pt'];
---

<Layout
  title="La Mer en Corps — Laurie Di Francesco"
  description={`La Mer en Corps — ${content.caption.replace(/<br \/>/g, ' ')}`}
  image="/images/work/la-mer-en-corps-cover.jpg"
  lang={lang}
>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="phero">
    <div class="phero-bg" aria-hidden="true">
      <img
        src="/images/work/la-mer-en-corps-cover.jpg"
        alt=""
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="phero-inner container">
      <p class="phero-eyebrow">{content.eyebrow}</p>
      <h1>La Mer<br /><strong>en Corps</strong></h1>
      <p class="phero-caption" set:html={content.caption}></p>
    </div>
  </section>

  <!-- ── Vidéo (2/3) + citations Bachelard (1/3) ──────────── -->
  <div class="lmec-vid-intro rv">
    <div class="lmec-vid-col">
      <div class="lmec-video-wrap">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          poster="/images/work/la-mer-en-corps-cover.jpg"
        >
          <source src="/images/work/la-mer-en-corps/lamerenCorps.mp4" type="video/mp4" />
        </video>
        <div class="lmec-video-overlay" aria-hidden="true">
          <svg class="lmec-play-icon" viewBox="0 0 48 48" fill="none">
            <circle cx="24" cy="24" r="23" fill="rgba(20,32,43,0.28)"/>
            <circle cx="24" cy="24" r="23" stroke="rgba(255,255,255,0.5)" stroke-width="1"/>
            <polygon points="18,13 36,24 18,35" fill="rgba(255,255,255,0.88)"/>
          </svg>
        </div>
        <button class="lmec-fullscreen-btn" aria-label="Full screen">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"/>
          </svg>
        </button>
      </div>
    </div>
    <div class="lmec-text-col">
      <div class="epi-wrap">
        <blockquote class="epi-justify">{content.bq1}</blockquote>
      </div>
      <div class="epi-wrap">
        <blockquote class="epi-justify lmec-bq-long">{content.bq2Long}</blockquote>
        <blockquote class="epi-justify lmec-bq-short">{content.bq2Short}</blockquote>
        <cite>
          {content.bachelardCite}
          {content.bachelardTransl && <span class="epi-tradfr">{content.bachelardTransl}</span>}
        </cite>
      </div>
    </div>
  </div>

  <!-- ── Texte du projet — pleine largeur ─────────────────── -->
  <div class="lmec-prose rv">
    <p class="opening-eyebrow">{content.sectionTitle}</p>
    <p class="opening-text"><span class="k" set:html={content.p1}></span></p>
    <p class="opening-text" set:html={content.p2}></p>
    <p class="opening-text">{content.clementineIntro}</p>
    <div class="epi-wrap">
      <blockquote class="epi-justify" set:html={content.clementineBq}></blockquote>
      <cite>Benjamin Clementine</cite>
    </div>
    <p class="opening-text">{content.p3}</p>
  </div>

  <!-- ── Texte avec photo flottante ──────────────────────────── -->
  <div class="lmec-prose rv">
    <figure class="lmec-photo-float">
      <img src="/images/work/la-mer-en-corps/GP010207.jpg" alt="" loading="lazy" />
      <figcaption>underwater, Mediterranean sea</figcaption>
    </figure>
    <p class="opening-text" set:html={content.p4}></p>
    <p class="opening-text">{content.p5}</p>
    <p class="opening-text" set:html={content.p6}></p>
    <p class="opening-text">{content.p7}</p>
    <p class="opening-text" set:html={content.p8}></p>
  </div>

  <!-- ── Projet suivant ───────────────────────────────────── -->
  <div class="next-project container">
    <span class="next-label">{t.work.nextProject}</span>
    <a href={`/${lang}/work/quando-sono-qui`}>Quando sono qui, non sono là →</a>
  </div>

</Layout>

<script>
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
    });
  }, { threshold: .06 });
  document.querySelectorAll('.rv').forEach(el => obs.observe(el));

  const vid     = document.querySelector('.lmec-video-wrap video') as HTMLVideoElement | null;
  const overlay = document.querySelector('.lmec-video-overlay') as HTMLElement | null;
  const fsBtn   = document.querySelector('.lmec-fullscreen-btn') as HTMLElement | null;

  if (vid && overlay) {
    const hide = () => overlay.classList.add('hidden');
    vid.addEventListener('playing', hide, { once: true });
    overlay.addEventListener('click', () => { vid.play(); hide(); });
  }
  if (fsBtn && vid) {
    fsBtn.addEventListener('click', () => {
      if (vid.requestFullscreen) vid.requestFullscreen();
      else if ((vid as any).webkitRequestFullscreen) (vid as any).webkitRequestFullscreen();
    });
  }
</script>
