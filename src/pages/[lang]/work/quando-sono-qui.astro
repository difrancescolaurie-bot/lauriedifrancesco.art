---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/pages/work-project.css';
import Citation from '../../../components/Citation.astro';
import NextProject from '../../../components/NextProject.astro';
import { ui, type Lang } from '../../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'pt' } },
  ];
}

const { lang } = Astro.params;
const t = ui[lang as Lang];

const descriptions: Record<Lang, string> = {
  en: 'A photographic crossing of the allegory of the cave: Brazilian cerrado, rock paintings, a childhood given new meaning. Ongoing series.',
  fr: "Une traversée photographique de l'allégorie de la caverne : cerrado brésilien, peintures rupestres, enfance ressignifiée. Série en cours.",
  it: "Un attraversamento fotografico dell'allegoria della caverna: cerrado brasiliano, pitture rupestri, un'infanzia risignificata. Serie in corso.",
  pt: 'Uma travessia fotográfica da alegoria da caverna: cerrado brasileiro, pinturas rupestres, uma infância ressignificada. Série em curso.',
};

const content = {
  fr: {
    plato: 'Et si on le forçait à regarder la lumière même, ne crois-tu pas que les yeux lui feraient mal et qu\'il se déroberait et retournerait aux choses qu\'il peut regarder, et qu\'il les croirait réellement plus distinctes que celles qu\'on lui montre ?',
    platoSrc: 'Platon · République, Livre VII',
    char: 'La lucidité est la blessure la plus rapprochée du soleil.',
    charSrc: 'René Char · Feuillets d\'Hypnos (169)',
    charNote: null as string | null,
    projectLabel: 'Le Projet',
    creditsLabel: 'Crédits',
    creditsText: "Image reproduite avec l'aimable autorisation de Tatila Lyma et Gisele Kimura.",
    projectParas: [
      "Le titre est resté en italien. Une phrase prononcée en passant, à propos d'une double appartenance devenue triple, adoptée désormais comme un écho à une identité faite de multiples rivages.",
      "Dans ce projet, le rivage géographique devient rivage intérieur.",
      "Tout se termine dans une caverne. Choisie, celle-là, et non subie : un lieu naturel classé, aux formes dessinées par l'eau et le temps, où l'on entre comme dans un abri enveloppant et fertile. Sur ses parois, des peintures rupestres. Des traits qui semblent presque enfantins, vieux de milliers d'années, que l'on protège et que personne ne songerait plus à brûler.",
      "Il y a un territoire profond, éloigné, des terres indigènes protégées et défendues. C'est de là que viennent les visages : la dignité, la colère, la paix retrouvée. On y rencontre une candeur, sous la lumière du cerrado, des tropiques, là où la fin du jour porte une autre densité.",
      "C'est pour tout cela qu'il fallait revenir : retrouver les marques d'un passé millénaire que rien ni personne n'a effacé, rencontrer des visages qui expriment les cycles d'une vie, empêchée d'abord, libérée après. On peut toujours faire quelque chose de ce qu'on a fait de nous.",
      "La série suit le mouvement de l'allégorie : les ombres prises pour le réel, la descente, la peur qui s'installe, puis la sortie. Elle ne cherche pas à démontrer et ne demande rien : elle traverse.",
      "La question qu'elle pose est simple : comment on tient, après une enfance où le regard des adultes fut un tribunal. Ces images ne répondent pas en témoignant. Elles sont faites depuis dehors, par un regard qui ne confond plus les ombres avec le réel.",
      "Transfigurer le réel : c'est de là que ces images sont faites. Nous avons l'art pour ne pas mourir de la vérité.",
    ],
  },
  it: {
    plato: 'E se lo si costringesse a guardare la luce stessa, non credi che gli occhi gli farebbero male, e che si sottrarrebbe per tornare alle cose che può guardare, credendole davvero più distinte di quelle che gli vengono mostrate?',
    platoSrc: 'Platone · Repubblica, Libro VII',
    char: 'La lucidità è la ferita più vicina al sole.',
    charSrc: 'René Char · Feuillets d\'Hypnos (169)',
    charNote: "tradotto liberamente dall'edizione francese",
    projectLabel: 'Il Progetto',
    creditsLabel: 'Crediti',
    creditsText: 'Immagine riprodotta per gentile concessione di Tatila Lyma e Gisele Kimura.',
    projectParas: [
      "Il titolo è rimasto in italiano. Una frase pronunciata di passaggio, a proposito di una doppia appartenenza diventata tripla, adottata ormai come eco di un'identità fatta di rive molteplici.",
      "In questo progetto, la riva geografica diventa riva interiore.",
      "Tutto finisce in una caverna. Scelta, questa, e non subita: un luogo naturale tutelato, dalle forme disegnate dall'acqua e dal tempo, dove si entra come in un rifugio avvolgente e fertile. Sulle sue pareti, pitture rupestri. Tratti che sembrano quasi infantili, vecchi di migliaia di anni, oggi protetti, e che nessuno penserebbe più di bruciare.",
      "C'è un territorio profondo, lontano, terre indigene protette e difese. È da lì che vengono i volti: la dignità, la rabbia, la pace ritrovata. Vi si incontra un candore, sotto la luce del cerrado, dei tropici, là dove la fine del giorno porta un'altra densità.",
      "È per tutto questo che bisognava tornare: ritrovare i segni di un passato millenario che niente e nessuno ha cancellato, incontrare volti che esprimono i cicli di una vita, prima impedita, poi liberata. Si può sempre fare qualcosa di ciò che hanno fatto di noi.",
      "La serie segue il movimento dell'allegoria: le ombre scambiate per il reale, la discesa, la paura che si insinua, poi l'uscita. Non cerca di dimostrare e non chiede nulla: attraversa.",
      "La domanda che pone è semplice: come si resta in piedi, dopo un'infanzia in cui lo sguardo degli adulti fu un tribunale. Queste immagini non rispondono testimoniando. Sono fatte da fuori, da uno sguardo che non scambia più le ombre per il reale.",
      "Trasfigurare il reale: è da lì che queste immagini sono fatte. Abbiamo l'arte per non morire della verità.",
    ],
  },
  pt: {
    plato: 'E se o forçassem a olhar para a própria luz, você não acha que os olhos lhe doeriam, e que ele se esquivaria para voltar às coisas que consegue olhar, julgando-as realmente mais nítidas do que aquelas que lhe mostram?',
    platoSrc: 'Platão · República, Livro VII',
    char: 'A lucidez é a ferida mais próxima do sol.',
    charSrc: 'René Char · Feuillets d\'Hypnos (169)',
    charNote: "traduzido livremente da edição francesa",
    projectLabel: 'O Projeto',
    creditsLabel: 'Créditos',
    creditsText: 'Imagem reproduzida com a gentil autorização de Tatila Lyma e Gisele Kimura.',
    projectParas: [
      "O título ficou em italiano. Uma frase dita de passagem, sobre um duplo pertencimento que se tornou triplo, adotada desde então como eco de uma identidade feita de muitas margens.",
      "Neste projeto, a margem geográfica se torna margem interior.",
      "Tudo termina numa caverna. Escolhida, esta, e não sofrida: um lugar natural tombado, de formas desenhadas pela água e pelo tempo, onde se entra como num abrigo envolvente e fértil. Nas suas paredes, pinturas rupestres. Traços que parecem quase infantis, com milhares de anos, hoje protegidos, e que ninguém pensaria mais em queimar.",
      "Há um território profundo, distante, terras indígenas protegidas e defendidas. É de lá que vêm os rostos: a dignidade, a raiva, a paz reencontrada. Ali se encontra uma candura, sob a luz do cerrado, dos trópicos, lá onde o fim do dia carrega outra densidade.",
      "Foi por tudo isso que era preciso voltar: reencontrar as marcas de um passado milenar que nada nem ninguém apagou, encontrar rostos que exprimem os ciclos de uma vida, impedida primeiro, libertada depois. Sempre se pode fazer alguma coisa daquilo que fizeram de nós.",
      "A série segue o movimento da alegoria: as sombras tomadas pelo real, a descida, o medo que se instala, depois a saída. Ela não procura demonstrar e não pede nada: ela atravessa.",
      "A pergunta que ela faz é simples: como se fica de pé, depois de uma infância em que o olhar dos adultos foi um tribunal. Estas imagens não respondem testemunhando. São feitas de fora, por um olhar que já não confunde as sombras com o real.",
      "Transfigurar o real: é daí que estas imagens são feitas. Temos a arte para não morrer da verdade.",
    ],
  },
}[lang as 'fr' | 'it' | 'pt'];

const s = (file: string) => `/images/work/quando-sono-qui/${file}`;
type Photo = { src: string; n: number; w: number; h: number };
type Spread = { type: 'row' | 'single'; photos: Photo[] };
const p = (n: number): Photo => ({ src: s(`${n}.jpg`), n, w: 2000, h: 1333 });
const galPhotoW = Math.round((2000 / 1333) * 403); // --rowh: 403px global

const spreads: Spread[] = [
  { type: 'row',    photos: [p(2), p(3), p(4)] },
  { type: 'single', photos: [p(5)] },
  { type: 'row',    photos: [p(6), p(7)] },
  { type: 'row',    photos: [p(8), p(9), p(10)] },
  { type: 'single', photos: [p(11)] },
  { type: 'row',    photos: [p(12), p(13)] },
  { type: 'row',    photos: [p(14), p(15), p(16)] },
  { type: 'single', photos: [{ src: s('15 2.jpg'), n: 15, w: 2000, h: 1333 }] },
  { type: 'row',    photos: [p(17), p(18), p(19)] },
  { type: 'row',    photos: [p(20), p(21), p(22)] },
  { type: 'single', photos: [p(23)] },
  { type: 'single', photos: [p(24)] },
];
---

<Layout
  title="Quando sono qui, non sono là · Laurie Di Francesco"
  description={descriptions[lang as Lang]}
  image="/images/work/quando-cover.jpg"
  lang={lang}
  bodyClass="page-quando"
  lightHeader={false}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "Quando sono qui, non sono là",
    "creator": { "@type": "Person", "name": "Laurie Di Francesco" },
    "url": `https://lauriedifrancesco.art/${lang}/work/quando-sono-qui`,
    "inLanguage": lang
  }}
>

  <!-- ── Hero ──────────────────────────────────────────────── -->
  <section class="phero">
    <div class="phero-bg" aria-hidden="true">
      <img src="/images/work/quando-sono-qui/1.jpg" alt="" loading="eager" fetchpriority="high" />
    </div>
    <div class="phero-inner container">
      <p class="phero-eyebrow">{t.home.projects[0].cerule}</p>
      <h1>Quando sono qui,<br /><strong>non sono là</strong></h1>
      <p class="phero-count" aria-live="polite"></p>
    </div>
  </section>

  <!-- ── Ouverture : gal-rows photo + citations ── -->
  <section class="gal-opening">

    <div class="gal-row rv">
      <figure class="gal-cell gal-cell--photo" style={`width: ${galPhotoW}px`}>
        <img src={s('0.jpg')} alt="" loading="lazy" width={2000} height={1333} />
      </figure>
      <div class="gal-cell gal-cell--cit">
        <Citation author={content.platoSrc}>
          {content.plato}
        </Citation>
        <Citation author={content.charSrc} note={content.charNote ?? undefined}>
          {content.char}
        </Citation>
      </div>
    </div>

    <div class="gal-row rv">
      <div class="gal-cell gal-cell--cit">
        <Citation author="José Ramalho Neto · Galope Resante">
          A sombra que me move<br />
          Também me ilumina<br />
          Me leve nos cabelos<br />
          Me lave na piscina<br />
          Em cada ponto claro<br />
          Cometa que cai no mar<br />
          Em cada cor diferente<br />
          Que tente me clarear<br />
          É noite que vai chegar<br />
          É claro que é de manhã<br />
          É moça e anciã
        </Citation>
      </div>
      <figure class="gal-cell gal-cell--photo" style={`width: ${galPhotoW}px`}>
        <img src={s('1.jpg')} alt="" loading="lazy" width={2000} height={1333} />
      </figure>
    </div>

    {content.projectParas && (
      <div class="gal-row rv">
        <div class="gal-cell gal-cell--text">
          <p class="opening-eyebrow">{content.projectLabel}</p>
          {content.projectParas.map((para: string) => (
            <p class="opening-text">{para}</p>
          ))}
          <a class="see-images" href="#serie"></a>
          <hr class="horizon" />
        </div>
      </div>
    )}

  </section>

  <!-- ── Série photographique ──────────────────────────────── -->
  <div class="series" id="serie">
    {spreads.map((spread) => (
      <div class={`spread spread--${spread.type} rv`}>
        {spread.photos.map((photo) => (
          <figure>
            <img
              src={photo.src}
              alt={`Quando sono qui, non sono là · ${photo.n}`}
              loading="lazy"
              width={photo.w}
              height={photo.h}
            />
          </figure>
        ))}
      </div>
    ))}
  </div>

  <!-- ── Crédits ─────────────────────────────────────────── -->
  <div class="project-credits">
    <div class="group">
      <div class="label">{content.creditsLabel}</div>
      <p>{content.creditsText}</p>
    </div>
  </div>

  <!-- ── Projet suivant ─────────────────────────────────────── -->
  <NextProject current="quando-sono-qui" lang={lang} label={t.work.nextProject} />

</Layout>

<script>
  function justify() {
    const mob = window.innerWidth <= 700;
    document.querySelectorAll<HTMLElement>('.spread--row').forEach(row => {
      const figs = Array.from(row.querySelectorAll<HTMLElement>('figure'));
      const imgs = figs.map(f => f.querySelector<HTMLImageElement>('img')!);
      const getR = (im: HTMLImageElement) => {
        const w = im.naturalWidth || Number(im.getAttribute('width'));
        const h = im.naturalHeight || Number(im.getAttribute('height'));
        return (w && h) ? w / h : 1;
      };
      function apply() {
        if (mob && figs.length === 2) {
          const avail = row.clientWidth - 4;
          const r0 = getR(imgs[0]), r1 = getR(imgs[1]);
          const w0 = Math.round(r0 / (r0 + r1) * avail);
          figs[0].style.flex = `0 0 ${w0}px`;
          figs[1].style.flex = `0 0 ${avail - w0}px`;
          return;
        }
        if (mob && figs.length === 3) {
          const avail = row.clientWidth - 4;
          const r0 = getR(imgs[0]), r1 = getR(imgs[1]);
          const w0 = Math.round(r0 / (r0 + r1) * avail);
          figs[0].style.flex = `0 0 ${w0}px`;
          figs[1].style.flex = `0 0 ${avail - w0}px`;
          figs[2].style.flex = '0 0 100%';
          return;
        }
        if (mob && figs.length === 4) {
          const avail = row.clientWidth - 4;
          ([[0,1],[2,3]] as [number,number][]).forEach(([a,b]) => {
            const ra = getR(imgs[a]), rb = getR(imgs[b]);
            const wa = Math.round(ra / (ra + rb) * avail);
            figs[a].style.flex = `0 0 ${wa}px`;
            figs[b].style.flex = `0 0 ${avail - wa}px`;
          });
          return;
        }
        imgs.forEach((im, i) => {
          figs[i].style.flex = `${getR(im).toFixed(4)} 1 0`;
        });
      }
      apply();
      imgs.forEach(im => {
        if (!im.complete || !im.naturalWidth) im.addEventListener('load', apply, { once: true });
      });
    });
  }
  function layoutGalRows() {
    const mob = window.innerWidth <= 700;
    const H = parseFloat(getComputedStyle(document.body).getPropertyValue('--rowh')) || 380;
    document.querySelectorAll<HTMLElement>('.gal-cell--photo').forEach(cell => {
      const img = cell.querySelector<HTMLImageElement>('img');
      if (!img) return;
      function apply() {
        if (mob) { cell.style.width = ''; return; }
        const w = img!.naturalWidth || Number(img!.getAttribute('width'));
        const h = img!.naturalHeight || Number(img!.getAttribute('height'));
        const r = (w && h) ? w / h : 1;
        cell.style.width = Math.round(r * H) + 'px';
      }
      apply();
      if (!img.complete || !img.naturalWidth) img.addEventListener('load', apply, { once: true });
    });
  }
  justify();
  layoutGalRows();
  window.addEventListener('resize', () => {
    clearTimeout((window as any)._jt);
    (window as any)._jt = setTimeout(() => { justify(); layoutGalRows(); }, 150);
  });

  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
    });
  }, { threshold: .06 });
  document.querySelectorAll('.rv').forEach(el => obs.observe(el));

</script>
