---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/pages/work-project.css';
import Citation from '../../../components/Citation.astro';
import NextProject from '../../../components/NextProject.astro';
import { ui, type Lang } from '../../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'pt' } },
  ];
}

const { lang } = Astro.params;
const t = ui[lang as Lang];

const files: Record<number, string> = {
  1:  'Slovenia_1.JPG',
  2:  'Slovenia_2.JPG',
  3:  'Slovenia_3.JPG',
  4:  'Slovenia_4.JPG',
  5:  'Slovenia_5.JPG',
  6:  'Slovenia_6.jpg',
  7:  'Slovenia_7.JPG',
  8:  'Slovenia_8.jpg',
  9:  'Slovenia_9.JPG',
  10: 'Slovenia_10.jpg',
  11: 'Slovenia_11.JPG',
};
const s = (n: number) => `/images/work/toward-the-blue/${files[n]}`;

const content = {
  fr: {
    eyebrow: 'LE PROJET',
    rilkeAuthor: 'Rainer Maria Rilke · Lettres à un jeune poète',
    rilkeNote: "traduction libre de l'édition brésilienne",
    rilkeText: "Ce qui est nécessaire est seulement ceci: la solitude, une grande solitude intérieure. Entrer en soi-même et ne rencontrer personne pendant des heures, il faut y parvenir. Être solitaire comme on l'était enfant, quand les adultes allaient et venaient, mêlés à des choses qui semblaient importantes […] pourquoi ne pas les regarder comme un enfant observe quelque chose d'étrange, depuis la profondeur de son propre monde, depuis l'ampleur de sa propre solitude, qui est elle-même un travail, une charge et un métier ?",
    nietzscheAuthor: 'Friedrich Nietzsche · Ainsi parlait Zarathoustra',
    nietzscheNote: undefined as string | undefined,
    nietzscheText: "Mais dites, mes frères, de quoi l'enfant est donc capable dont ne le fut pas le lion ? Pourquoi faut-il donc que le lion féroce devienne un enfant ? L'enfant est innocence et oubli, un recommencement, un jeu, une roue roulant d'elle-même, un premier mouvement, un « oui » sacré.",
    project: [
      "La série s'ouvre sur le regard d'une jeune fille et se referme sur le visage d'une femme adulte. Entre les deux, des dragons de pierre, un toboggan vu de trop près, des vitres qui décomposent la lumière, des bâches, des reflets. Presque pas de cauchemar. Mais le voile est là.",
      "Le bleu du ciel traverse l'ensemble de ce travail comme un opérateur conceptuel. Il est le même d'un bout à l'autre de la terre, au-dessus des guerres comme au-dessus des jeux. C'est peut-être pour cela qu'il tient : il ne promet rien et il ne cède pas.",
      "Cette série s'inscrit dans le courant du réalisme magique. Un regard tropical plus que brésilien, celui de quelqu'un qui a vécu assez longtemps en Amérique latine pour que le merveilleux cesse d'être une exception.",
      "Il y a bien un passage, de l'enfant à l'adulte. Mais il ne raconte pas comment on grandit. Il réécrit ce passage à l'endroit où l'enfance a manqué, et cherche à récupérer après coup une légèreté qui n'a pas eu lieu.",
      "Chez Nietzsche, l'enfant ne vient pas en premier. Il vient après le fardeau du chameau et après le refus du lion.",
    ],
    creditsLabel: 'Crédits & remerciements',
    creditsText: "Images reproduites avec l'aimable autorisation d'Ana Valant et Tereza Kozinc — avec mes remerciements à Tereza et à Klavdij Sluban, qui ont su mettre des mots justes sur ma façon de voir.",
  },
  it: {
    eyebrow: 'IL PROGETTO',
    rilkeAuthor: 'Rainer Maria Rilke · Lettere a un giovane poeta',
    rilkeNote: "traduzione libera dall'edizione brasiliana",
    rilkeText: "Ciò che è necessario è soltanto questo: solitudine, una grande solitudine interiore. Entrare in se stessi e non incontrare nessuno per ore, bisogna riuscirci. Essere solitari come lo si era da bambini, quando gli adulti andavano avanti e indietro, presi da cose che sembravano importanti […] perché non guardarli come un bambino osserva qualcosa di strano, dalla profondità del proprio mondo, dall'ampiezza della propria solitudine, che è essa stessa un lavoro, un incarico e una professione?",
    nietzscheAuthor: 'Friedrich Nietzsche · Così parlò Zarathustra',
    nietzscheNote: "traduzione libera dall'edizione francese" as string | undefined,
    nietzscheText: "Ma dite, fratelli miei, di che cosa è capace il bambino, che il leone non poteva? Perché il leone feroce deve ancora diventare bambino? Il bambino è innocenza e oblio, un ricominciamento, un gioco, una ruota che gira da sé, un primo movimento, un sacro «sì».",
    project: [
      'La serie si apre sullo sguardo di una ragazza e si chiude sul volto di una donna adulta. Nel mezzo: draghi di pietra, uno scivolo visto troppo da vicino, vetri che scompongono la luce, teloni, riflessi. Quasi nessun incubo. Ma il velo c\'è.',
      "L'azzurro del cielo attraversa tutto questo lavoro come un operatore concettuale. È lo stesso da un capo all'altro della terra, sopra le guerre come sopra i giochi. Forse è per questo che tiene: non promette nulla e non cede.",
      "Questa serie si inscrive nella corrente del realismo magico. Uno sguardo tropicale più che brasiliano, quello di chi ha vissuto in America Latina abbastanza a lungo perché il meraviglioso smetta di essere un'eccezione.",
      "C'è davvero un passaggio, dalla bambina all'adulta. Ma non racconta come si diventa grandi. Riscrive quel passaggio là dove l'infanzia è mancata, e cerca di recuperare a posteriori una leggerezza che non c'è stata.",
      'In Nietzsche, il bambino non viene per primo. Viene dopo il fardello del cammello e dopo il rifiuto del leone.',
    ],
    creditsLabel: 'Crediti e ringraziamenti',
    creditsText: 'Immagini riprodotte per gentile concessione di Ana Valant e Tereza Kozinc, con un ringraziamento a Tereza e a Klavdij Sluban, che hanno saputo dare le parole giuste al mio modo di vedere.',
  },
  pt: {
    eyebrow: 'O PROJETO',
    rilkeAuthor: 'Rainer Maria Rilke · Cartas a um jovem poeta',
    rilkeNote: undefined as string | undefined,
    rilkeText: "O que é necessário é apenas o seguinte: solidão, uma grande solidão interior. Entrar em si mesmo e não encontrar ninguém durante horas, é preciso conseguir isso. Ser solitário como se era quando criança, quando os adultos passavam para lá e para cá, envolvidos com coisas que pareciam importantes […] por que não olhar para eles como uma criança observa algo de estranho, a partir da profundeza do próprio mundo, da amplitude da própria solidão, que é ela mesma um trabalho, um cargo e uma profissão?",
    nietzscheAuthor: 'Friedrich Nietzsche · Assim falou Zaratustra',
    nietzscheNote: 'tradução livre da edição francesa' as string | undefined,
    nietzscheText: 'Mas digam, meus irmãos, do que é capaz a criança que o leão não foi? Por que o leão feroz precisa ainda tornar-se criança? A criança é inocência e esquecimento, um recomeço, um jogo, uma roda que gira por si mesma, um primeiro movimento, um "sim" sagrado.',
    project: [
      'A série se abre no olhar de uma menina e se fecha no rosto de uma mulher adulta. Entre os dois: dragões de pedra, um escorregador visto de perto demais, vidros que decompõem a luz, lonas, reflexos. Quase nenhum pesadelo. Mas o véu está lá.',
      'O azul do céu atravessa todo este trabalho como um operador conceitual. É o mesmo de um extremo a outro da terra, acima das guerras como acima das brincadeiras. Talvez seja por isso que ele sustenta: não promete nada e não cede.',
      'Esta série se inscreve na corrente do realismo mágico. Um olhar tropical mais que brasileiro, o de quem viveu na América Latina o tempo suficiente para que o maravilhoso deixe de ser uma exceção.',
      'Há de fato uma passagem, da criança à adulta. Mas ela não conta como se cresce. Reescreve essa passagem onde a infância faltou, e busca recuperar depois uma leveza que não aconteceu.',
      'Em Nietzsche, a criança não vem primeiro. Vem depois do fardo do camelo e depois da recusa do leão.',
    ],
    creditsLabel: 'Créditos e agradecimentos',
    creditsText: 'Imagens reproduzidas com a gentil autorização de Ana Valant e Tereza Kozinc — com um agradecimento a Tereza e a Klavdij Sluban, que souberam encontrar as palavras certas para o meu modo de ver.',
  },
}[lang as 'fr' | 'it' | 'pt'];

type Photo = { src: string; n: number };
type Spread = { type: 'row' | 'single'; photos: Photo[]; caption?: string };

const spreads: Spread[] = [
  { type: 'single', photos: [{ src: s(3), n: 3 }] },
  { type: 'row',    photos: [{ src: s(4), n: 4 }, { src: s(5), n: 5 }, { src: s(6), n: 6 }] },
  { type: 'row',    photos: [{ src: s(7), n: 7 }, { src: s(8), n: 8 }] },
  { type: 'single', photos: [{ src: s(9), n: 9 }] },
  { type: 'row',    photos: [{ src: s(10), n: 10 }, { src: s(11), n: 11 }] },
];
---

<Layout
  title="Toward the Blue · Laurie Di Francesco"
  description="Toward the Blue · a photographic series by Laurie Di Francesco."
  image="/images/work/toward-the-blue-cover.jpg"
  lang={lang}
  bodyClass="page-toward"
  lightHeader={false}
>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="phero">
    <div class="phero-bg" aria-hidden="true">
      <img src="/images/work/toward-the-blue/Slovenia_5.JPG" alt="" loading="eager" />
    </div>
    <div class="phero-inner container">
      <p class="phero-eyebrow">{t.home.projects[1].cerule}</p>
      <h1>Toward<br /><strong>the Blue</strong></h1>
    </div>
  </section>

  <!-- ── Ouverture : trois rangées photo + citation + texte ── -->
  <section class="gal-opening">

    <div class="gal-row rv">
      <figure class="gal-cell gal-cell--photo">
        <img src={s(1)} alt="Toward the Blue · photo 1" loading="lazy" />
      </figure>
      <div class="gal-cell gal-cell--cit">
        <Citation author={content.rilkeAuthor} note={content.rilkeNote}>
          {content.rilkeText}
        </Citation>
      </div>
    </div>

    <div class="gal-row rv">
      <div class="gal-cell gal-cell--cit">
        <Citation author={content.nietzscheAuthor} note={content.nietzscheNote}>
          {content.nietzscheText}
        </Citation>
      </div>
      <figure class="gal-cell gal-cell--photo">
        <img src={s(2)} alt="Toward the Blue · photo 2" loading="lazy" />
      </figure>
    </div>

    <div class="gal-row rv">
      <div class="gal-cell gal-cell--text">
        <p class="opening-eyebrow">{content.eyebrow}</p>
        {content.project.map((para) => (
          <p class="intro-text">{para}</p>
        ))}
        <hr class="horizon intro-proj-horizon" />
      </div>
    </div>

  </section>

  <!-- ── Série photographique ──────────────────────────────── -->
  <div class="series">
    {spreads.map((spread) => (
      <>
        <div class={`spread spread--${spread.type} rv`}>
          {spread.photos.map((photo) => (
            <figure>
              <img src={photo.src} data-full={photo.src} alt={`Toward the Blue · photo ${photo.n}`} loading="lazy" />
            </figure>
          ))}
        </div>
        {spread.caption && (
          <p class="series-caption rv">
            {spread.caption}
          </p>
        )}
      </>
    ))}
  </div>

  <!-- ── Crédits ─────────────────────────────────────────── -->
  <div class="project-credits">
    <div class="group">
      <div class="label">{content.creditsLabel}</div>
      <p>{content.creditsText}</p>
    </div>
  </div>

  <!-- ── Projet suivant ─────────────────────────────────────── -->
  <NextProject current="toward-the-blue" lang={lang} label={t.work.nextProject} />

</Layout>


<script>
  function justify() {
    const mob = window.innerWidth <= 700;
    const H = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--rowh')) || 403;
    document.querySelectorAll<HTMLElement>('.spread--row').forEach(row => {
      const figs = Array.from(row.querySelectorAll<HTMLElement>('figure'));
      const imgs = figs.map(f => f.querySelector<HTMLImageElement>('img')!);
      const getR = (im: HTMLImageElement) =>
        (im.naturalWidth && im.naturalHeight) ? im.naturalWidth / im.naturalHeight : 1;
      function apply() {
        if (mob && figs.length === 3) {
          figs[0].style.flex = `${getR(imgs[0]).toFixed(4)} 1 0`;
          figs[1].style.flex = `${getR(imgs[1]).toFixed(4)} 1 0`;
          figs[2].style.flex = '0 0 100%';
          return;
        }
        if (mob && figs.length === 4) {
          const avail = row.clientWidth - 8;
          ([[0,1],[2,3]] as [number,number][]).forEach(([a,b]) => {
            const ra = getR(imgs[a]), rb = getR(imgs[b]);
            const wa = Math.round(ra / (ra + rb) * avail);
            figs[a].style.flex = `0 0 ${wa}px`;
            figs[b].style.flex = `0 0 ${avail - wa}px`;
          });
          return;
        }
        const sumR = imgs.reduce((s, im) => s + getR(im), 0);
        const totalW = Math.round(sumR * H) + (figs.length - 1) * 16;
        if (totalW > row.clientWidth + 2) {
          imgs.forEach((im, i) => {
            figs[i].style.flex = '';
            figs[i].style.flexGrow = getR(im).toFixed(4);
          });
        } else {
          imgs.forEach((im, i) => {
            figs[i].style.flex = `0 0 ${Math.round(getR(im) * H)}px`;
          });
        }
      }
      if (imgs.every(im => im.complete && im.naturalWidth)) apply();
      else imgs.forEach(im => im.addEventListener('load', apply));
    });
  document.querySelectorAll<HTMLElement>('.spread--single').forEach(single => {
    const fig = single.querySelector<HTMLElement>('figure');
    const img = fig && fig.querySelector<HTMLImageElement>('img');
    if (!fig || !img) return;
    function applyS() {
      if (mob) { fig.style.flex = ''; return; }
      const r = img!.naturalWidth && img!.naturalHeight ? img!.naturalWidth / img!.naturalHeight : 1;
      fig.style.flex = `0 0 ${Math.round(r * H)}px`;
    }
    if (img.complete && img.naturalWidth) applyS();
    else img.addEventListener('load', applyS);
  });
  }
  function layoutGalRows() {
    const mob = window.innerWidth <= 700;
    const H = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--rowh')) || 380;
    document.querySelectorAll<HTMLElement>('.gal-cell--photo').forEach(cell => {
      const img = cell.querySelector<HTMLImageElement>('img');
      if (!img) return;
      function apply() {
        if (mob) { cell.style.width = ''; return; }
        const r = img!.naturalWidth && img!.naturalHeight
          ? img!.naturalWidth / img!.naturalHeight : 1;
        cell.style.width = Math.round(r * H) + 'px';
      }
      if (img.complete && img.naturalWidth) apply();
      else img.addEventListener('load', apply);
    });
  }
  justify();
  layoutGalRows();
  window.addEventListener('resize', () => { clearTimeout((window as any)._jt); (window as any)._jt = setTimeout(() => { justify(); layoutGalRows(); }, 150); });

  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); } });
  }, { threshold: .06 });
  document.querySelectorAll('.rv').forEach(el => obs.observe(el));

</script>
