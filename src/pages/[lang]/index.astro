---
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/home.css';
import { ui, type Lang } from '../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'pt' } },
  ];
}

const { lang } = Astro.params;
const t = ui[lang as Lang];
const th = t.home;

const heroImages = [
  '/images/hero/hero-2.jpg',
  '/images/hero/hero-3.jpg',
  '/images/hero/hero-4.jpg',
  '/images/hero/hero-1.jpg',
];

const wipProjects = [
  {
    href: `/${lang}/work/quando-sono-qui`,
    title: 'Quando sono qui, non sono là',
    cerule: th.projects[0].cerule,
    note: th.projects[0].note,
    image: '/images/work/quando-cover.jpg',
  },
  {
    href: `/${lang}/work/la-mer-en-corps`,
    title: 'La Mer en Corps',
    cerule: t.work.laMerCerule,
    note: t.work.laMerNote,
    image: '/images/work/la-mer-en-corps-cover.jpg',
  },
];

const prevProjects = [
  {
    href: `/${lang}/work/toward-the-blue`,
    title: 'Toward the Blue',
    cerule: th.projects[1].cerule,
    image: '/images/work/toward-the-blue-cover.jpg',
  },
  {
    href: `/${lang}/work/en-corps-en-la-mer`,
    title: 'En Corps à la Mer',
    cerule: th.projects[2].cerule,
    image: '/images/work/en-corps-cover.jpg',
  },
];
---

<Layout
  title="Home"
  description={`${th.heroLine1} · ${th.heroLine2}`}
  lang={lang}
>

  <!-- ─── Hero ─────────────────────────────────────────────── -->
  <section class="hero" aria-label="Hero">

    <div class="hero-bg" aria-hidden="true">
      {heroImages.map((src, i) => (
        <img
          src={src}
          alt=""
          loading={i === 0 ? 'eager' : 'lazy'}
          style={`animation-delay: ${i * 2}s`}
        />
      ))}
    </div>

    <div class="hero-inner container">
      <h1>
        Laurie<br />
        <span class="l2">Di Francesco</span>
      </h1>
      <hr class="horizon hero-horizon" />
      <p class="hero-tag">
        {th.heroLine1}<br />
        <em>{th.heroLine2}</em>
      </p>
    </div>

  </section>

  <!-- ─── Manifeste trilingue ───────────────────────────────── -->
  <section class="creed container" aria-label="Manifesto">
    <p class="creed-eyebrow">{th.creedEyebrow}</p>
    <div class="creed-lines">
      <p class="creed-it">Quando sono qui, non sono là.</p>
      <p class="creed-fr">Quand je suis ici, je ne suis pas là-bas.</p>
      <p class="creed-pt">Quando estou aqui, não estou lá.</p>
    </div>
  </section>

  <!-- ─── Aperçu des œuvres ─────────────────────────────────── -->
  <section class="works container" aria-label="Selected work">

    {wipProjects.map(p => (
      <a class="work-item" href={p.href}>
        <div class="work-frame">
          <img src={p.image} alt={p.title} loading="lazy" />
        </div>
        <div class="work-meta">
          <span class="work-category">{p.cerule}</span>
          <h2 class="work-title">{p.title}</h2>
          <p class="work-note" set:html={p.note}></p>
          <span class="work-enter">{th.enter}</span>
        </div>
      </a>
    ))}

    <div class="works-divider">
      <hr class="works-divider-line" />
      <p class="works-divider-label">{th.previousWorks}</p>
    </div>

    <div class="works-prev-grid">
      {prevProjects.map(p => (
        <a class="work-item work-item--prev" href={p.href}>
          <div class="work-frame">
            <img src={p.image} alt={p.title} loading="lazy" />
          </div>
          <div class="work-meta">
            <span class="work-category">{p.cerule}</span>
            <h2 class="work-title">{p.title}</h2>
          </div>
        </a>
      ))}
    </div>

    <div class="works-more">
      <a href={`/${lang}/work`} class="works-more-link">{th.viewMore}</a>
    </div>

  </section>

</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          observer.unobserve(e.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('.work-item').forEach(el => observer.observe(el));
</script>
