---
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/exhibitions.css';
import { ui, type Lang } from '../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'pt' } },
  ];
}

const { lang } = Astro.params;
const t = ui[lang as Lang].exhibitions;
---

<Layout
  title={t.eyebrow}
  description={t.description}
  image="/images/og-exhibitions.jpg"
  lang={lang}
  jsonLd={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ExhibitionEvent",
        "name": t.osTitle,
        "startDate": "2026-08-30",
        "endDate": "2026-08-30",
        "location": {
          "@type": "Place",
          "name": "Studio7.6",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "76 rue de Tilsit",
            "postalCode": "13006",
            "addressLocality": "Marseille",
            "addressCountry": "FR"
          }
        },
        "organizer": { "@type": "Organization", "name": "Monolit" },
        "performer": { "@type": "Person", "name": "Laurie Di Francesco" }
      },
      {
        "@type": "ExhibitionEvent",
        "name": t.exhibitionTitle,
        "startDate": "2024-07",
        "location": {
          "@type": "Place",
          "name": "Livraria da Rua",
          "address": { "@type": "PostalAddress", "addressLocality": "Belo Horizonte", "addressCountry": "BR" }
        },
        "performer": { "@type": "Person", "name": "Laurie Di Francesco" }
      }
    ]
  }}
>

  <!-- ── Titre de page ──────────────────────────────────────── -->
  <section class="ex-head container">
    <h1 class="ex-eyebrow">{t.eyebrow}</h1>
  </section>

  <!-- ── Sommaire ───────────────────────────────────────────── -->
  <nav class="ex-list" aria-label={t.listAria}>
    <a class="ex-list-row" href="#open-studio">
      <span class="ex-list-year">2026</span>
      <span class="ex-list-title">{t.osTitle}</span>
      <span class="ex-list-kind">{t.kindGroup}</span>
      <span class="ex-list-place">{t.osListPlace}</span>
      <span class="ex-list-link">{t.seeDetail}</span>
    </a>
    <a class="ex-list-row" href="#spilling-beyond-the-lines">
      <span class="ex-list-year">2024</span>
      <span class="ex-list-title">{t.exhibitionTitle}</span>
      <span class="ex-list-kind">{t.kindSolo}</span>
      <span class="ex-list-place">{t.soloListPlace}</span>
      <span class="ex-list-link">{t.seeDetail}</span>
    </a>
  </nav>

  <!-- ── Bloc Open Studio ───────────────────────────────────── -->
  <section class="ex-block rv" id="open-studio">
    <div class="ex-block-head">
      <h2 class="ex-h1">{t.osTitle}</h2>
      <p class="ex-meta">
        <span class="ex-meta-accent">{t.osMetaFirst}</span>
        &nbsp;·&nbsp; {t.osMetaVenue} · {t.osMetaLocation}
        &nbsp;·&nbsp; {t.osMetaDate}
        &nbsp;·&nbsp; {t.osMetaCount}
      </p>
      <hr class="horizon ex-horizon" />
    </div>

    <div class="ex-os-row">
      <div class="ex-os-figure">
        <div class="ex-artwork-pair ex-artwork-pair--single">
          <figure class="ex-artwork-fig ex-artwork-fig--poster">
            <img
              src="/images/exhibitions/open-studio-monolit.jpg"
              alt={t.osImageAlt}
              loading="lazy"
              width="1080"
              height="1350"
              class="ex-artwork-img"
            />
          </figure>
        </div>
        <div class="ex-artwork-caption">
          <div class="ex-artwork-title-block">
            <span class="ex-artwork-border"></span>
            <div>
              <p class="ex-artwork-title-pt">{t.osCaptionTitle}</p>
              <p class="ex-artwork-title-en">{t.osCaptionCredit}</p>
              <p class="ex-artwork-tech">{t.osCaptionTech}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="ex-intro ex-intro--side">
        <p class="ex-intro-label">{t.introLabel}</p>
        <p class="ex-intro-text">{t.osIntroText}</p>
        <a class="ex-link ex-link--spill" href={`/${lang}/work/spilling-beyond-the-lines`}>
          {t.viewProject}
        </a>
      </div>
    </div>
  </section>

  <!-- ── Séparateur ─────────────────────────────────────────── -->
  <div class="ex-sep"><hr class="horizon horizon--full" /></div>

  <!-- ── Bloc Belo Horizonte ────────────────────────────────── -->
  <section class="ex-block" id="spilling-beyond-the-lines">
    <div class="ex-block-head">
      <h2 class="ex-h1">{t.exhibitionTitle}</h2>
      <p class="ex-meta">
        <span class="ex-meta-accent">{t.metaFirst}</span>
        &nbsp;·&nbsp; Livraria da Rua · {t.metaLocation}
        &nbsp;·&nbsp; {t.metaDate}
        &nbsp;·&nbsp; {t.metaCount}
      </p>
      <hr class="horizon ex-horizon" />
    </div>

  <!-- ── Bloc œuvre + collectionneurs ──────────────────────── -->
  <div class="ex-artwork-wrap rv in">
    <div class="ex-artwork-pair" id="artwork-pair">
      <figure class="ex-artwork-fig" id="fig-artwork">
        <img
          src="/images/exhibitions/artwork.jpg"
          alt="Crianças no parque brincando nos chafarizes"
          loading="eager"
          class="ex-artwork-img"
        />
      </figure>
      <figure class="ex-artwork-fig" id="fig-collectors">
        <img
          src="/images/exhibitions/WhatsApp Image 2026-06-24 at 11.26.44.jpg"
          alt="Collectors with the work"
          loading="eager"
          class="ex-artwork-img"
        />
      </figure>
    </div>

    <div class="ex-artwork-caption">
      <div class="ex-artwork-title-block">
        <span class="ex-artwork-border"></span>
        <div>
          <p class="ex-artwork-title-pt">Crianças no parque brincando nos chafarizes</p>
          <p class="ex-artwork-title-en">{t.artworkTitle}</p>
          <p class="ex-artwork-tech">Paris, 2010 · {t.artworkTech}</p>
          <p class="ex-artwork-status">{t.artworkStatus}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Texte d'intro ─────────────────────────────────────── -->
  <div class="ex-intro rv">
    <p class="ex-intro-label">{t.introLabel}</p>
    <p class="ex-intro-text" set:html={t.introText} />
    <a class="ex-link ex-link--spill" href={`/${lang}/work/spilling-beyond-the-lines`}>
      {t.viewProject}
    </a>
  </div>

  <!-- ── Grille vues d'accrochage ──────────────────────────── -->
  <div class="ex-grid-wrap">

    <!-- Rangée 1 : 3 photos -->
    <div class="ex-grid-row">
      <figure class="ex-grid-fig">
        <img src="/images/exhibitions/1.jpg" alt="" loading="lazy" class="ex-grid-img crop-right" />
      </figure>
      <figure class="ex-grid-fig">
        <img src="/images/exhibitions/2.jpg" alt="" loading="lazy" class="ex-grid-img" />
      </figure>
      <figure class="ex-grid-fig">
        <img src="/images/exhibitions/3.jpg" alt="" loading="lazy" class="ex-grid-img" />
      </figure>
    </div>

    <!-- Rangée 2 : 2 photos -->
    <div class="ex-grid-row">
      <figure class="ex-grid-fig">
        <img src="/images/exhibitions/4.jpg" alt="" loading="lazy" class="ex-grid-img" />
      </figure>
      <figure class="ex-grid-fig">
        <img src="/images/exhibitions/5.jpg" alt="" loading="lazy" class="ex-grid-img" />
      </figure>
    </div>

    <!-- Rangée 3 : 4 photos -->
    <div class="ex-grid-row">
      <figure class="ex-grid-fig">
        <img src="/images/exhibitions/7.jpg" alt="" loading="lazy" class="ex-grid-img" />
      </figure>
      <figure class="ex-grid-fig">
        <img src="/images/exhibitions/8.jpg" alt="" loading="lazy" class="ex-grid-img" />
      </figure>
      <figure class="ex-grid-fig">
        <img src="/images/exhibitions/10.jpg" alt="" loading="lazy" class="ex-grid-img" />
      </figure>
      <figure class="ex-grid-fig">
        <img src="/images/exhibitions/11.jpg" alt="" loading="lazy" class="ex-grid-img" />
      </figure>
    </div>

  </div>

  <!-- ── Impression / Encadrement / Montage ────────────────── -->
  <div class="ex-craft">
    <p class="ex-craft-eyebrow">{t.craftEyebrow}</p>
    <p class="ex-craft-sub">{t.craftSub}</p>

    <div class="ex-videos">

      <div class="ex-video-col">
        <video src="/videos/loop-print.mp4" autoplay muted loop playsinline class="ex-video"></video>
        <p class="ex-video-label">{t.videoLabels.print}</p>
        <p class="ex-video-title">Studio Artmosphere</p>
        <p class="ex-credit-detail" set:html={t.creditPrint} />
      </div>

      <div class="ex-video-col">
        <video src="/videos/loop-frame.mp4" autoplay muted loop playsinline class="ex-video"></video>
        <p class="ex-video-label">{t.videoLabels.frame}</p>
        <p class="ex-video-title">Atelier Baumecker</p>
        <p class="ex-credit-detail" set:html={t.creditFrame} />
      </div>

      <div class="ex-video-col">
        <video src="/videos/loop-mount.mp4" autoplay muted loop playsinline class="ex-video"></video>
        <p class="ex-video-label">{t.videoLabels.mount}</p>
        <p class="ex-video-title">Jackson Cardoso</p>
        <p class="ex-credit-detail" set:html={t.creditMount} />
      </div>

    </div>
  </div>

  <!-- ── Remerciements ─────────────────────────────────────── -->
  <div class="ex-thanks rv">
    <p class="ex-thanks-label">{t.thanksLabel}</p>
    <p class="ex-thanks-text" set:html={t.thanksText} />
  </div>

  </section>

</Layout>

<script>
  function justifyGrid() {
    const mob = window.innerWidth <= 700;
    document.querySelectorAll<HTMLElement>('.ex-grid-row').forEach(row => {
      const figs = Array.from(row.querySelectorAll<HTMLElement>('.ex-grid-fig'));
      const imgs = figs.map(f => f.querySelector('img') as HTMLImageElement);
      const getR = (im: HTMLImageElement) =>
        (im.naturalWidth && im.naturalHeight) ? im.naturalWidth / im.naturalHeight : 1;
      function apply() {
        if (mob && figs.length === 3) {
          figs[0].style.flex = `${getR(imgs[0]).toFixed(4)} 1 0`;
          figs[1].style.flex = `${getR(imgs[1]).toFixed(4)} 1 0`;
          figs[2].style.flex = '0 0 100%';
          return;
        }
        if (mob && figs.length === 4) {
          const avail = row.clientWidth - 8;
          ([[0,1],[2,3]] as [number,number][]).forEach(([a,b]) => {
            const ra = getR(imgs[a]), rb = getR(imgs[b]);
            const wa = Math.round(ra / (ra + rb) * avail);
            figs[a].style.flex = `0 0 ${wa}px`;
            figs[b].style.flex = `0 0 ${avail - wa}px`;
          });
          return;
        }
        imgs.forEach((im, i) => {
          figs[i].style.flex = `${getR(im).toFixed(4)} 1 0`;
        });
      }
      if (imgs.every(im => im.complete && im.naturalWidth)) apply();
      else imgs.forEach(im => im.addEventListener('load', apply));
    });
  }
  justifyGrid();
  window.addEventListener('resize', () => {
    clearTimeout((window as any)._jg);
    (window as any)._jg = setTimeout(justifyGrid, 150);
  });

  function justifyArtwork() {
    const pair = document.getElementById('artwork-pair');
    if (!pair) return;
    const figs = Array.from(pair.querySelectorAll('.ex-artwork-fig'));
    const imgs = figs.map(f => f.querySelector('img') as HTMLImageElement);

    function apply() {
      imgs.forEach((img, i) => {
        if (img.naturalWidth && img.naturalHeight) {
          figs[i].style.flexGrow = (img.naturalWidth / img.naturalHeight).toFixed(4);
        }
      });
    }

    let pending = imgs.filter(img => !img.complete || !img.naturalWidth).length;
    if (pending === 0) { apply(); return; }
    imgs.forEach(img => {
      if (!img.complete || !img.naturalWidth) {
        img.addEventListener('load', () => { if (--pending <= 0) apply(); }, { once: true });
        img.addEventListener('error', () => { if (--pending <= 0) apply(); }, { once: true });
      }
    });
  }

  const observer = new IntersectionObserver(
    entries => entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); observer.unobserve(e.target); }
    }),
    { threshold: 0.08 }
  );
  document.querySelectorAll('.rv').forEach(el => observer.observe(el));

  justifyArtwork();
</script>
