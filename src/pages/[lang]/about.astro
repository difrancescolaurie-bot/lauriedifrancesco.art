---
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/about.css';
import Citation from '../../components/Citation.astro';
import { ui, type Lang } from '../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'pt' } },
  ];
}

const { lang } = Astro.params;
const t = ui[lang as Lang].about;
---

<Layout
  title={t.pageTitle}
  description={t.description}
  lang={lang}
>

  <!-- ── Titre + Épigraphe ────────────────────────────── -->
  <section class="about-head container">
    <p class="about-eyebrow">{t.eyebrow}</p>
    <h1 class="about-h1">Laurie Di Francesco</h1>

    <Citation author={t.epigraphCite}>
      <Fragment set:html={t.epigraph} />
    </Citation>
  </section>

  <!-- ── Bio ───────────────────────────────────────────── -->
  <div class="about-bio">

    <div class="bio-marg">

      <!-- Lead -->
      <div class="bio-marg-lab"></div>
      <div class="bio-marg-par">
        <p class="bio-marg-lead" set:html={t.bio.p1} />
      </div>

      <!-- Origins -->
      <div class="bio-marg-lab">{t.bioLabels.origins}</div>
      <div class="bio-marg-par">
        <p set:html={t.bio.p2} />
      </div>

      <!-- Learning -->
      <div class="bio-marg-lab">{t.bioLabels.learning}</div>
      <div class="bio-marg-par">
        <p set:html={t.bio.p3} />
      </div>

      <!-- Approach -->
      <div class="bio-marg-lab">{t.bioLabels.approach}</div>
      <div class="bio-marg-par">
        <p set:html={t.bio.p4} />
        <p set:html={t.bio.p5} />
      </div>

      <!-- Work -->
      <div class="bio-marg-lab">{t.bioLabels.work}</div>
      <div class="bio-marg-par">
        <p set:html={t.bio.p6} />
        {t.bio.p7 && <p set:html={t.bio.p7} />}
      </div>

    </div>

    <!-- ── Refs table ──────────────────────────────────── -->
    <div class="bio-refs">
      <div>
        <p class="bio-refs-title">{t.refsLabels.collective}</p>
        <p class="bio-refs-content">Monolit<br />{t.refsLabels.collectiveFoundedBy}</p>
      </div>
      <div>
        <p class="bio-refs-title">{t.refsLabels.training}</p>
        <p class="bio-refs-content">Ateliê da Imagem, Rio de Janeiro<br />ENSP, Arles<br />Les Rencontres de la Photographie d'Arles</p>
      </div>
      <div>
        <p class="bio-refs-title">{t.refsLabels.workshops}</p>
        <p class="bio-refs-content">Fabienne Pavia, Éditions Le Bec en l'Air<br />Antoine d'Agata<br />Klavdij Sluban</p>
      </div>
      <div>
        <p class="bio-refs-title">{t.refsLabels.inspirations}</p>
        <p class="bio-refs-content">Claudia Andujar · Graciela Iturbide · Luigi Ghirri · Jacques-Henri Lartigue · Manuel Álvarez Bravo · Miguel Rio Branco · José Diniz · Letizia Battaglia</p>
      </div>
    </div>

  </div>

</Layout>
