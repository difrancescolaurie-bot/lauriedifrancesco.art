---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import '../styles/global.css';
import { ui, type Lang } from '../i18n/translations';

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
  bodyClass?: string;
  lightHeader?: boolean;
  hasTranslations?: boolean;
  noindex?: boolean;
  jsonLd?: object;
}

const { title, image = "/og-default.jpg", lang = "en", bodyClass, lightHeader = true, hasTranslations = true, noindex = false, jsonLd } = Astro.props;

const validLang: Lang = (lang === 'fr' || lang === 'it' || lang === 'pt') ? lang as Lang : 'en';
const t = ui[validLang];
const htmlLang = lang === 'pt' ? 'pt-BR' : lang;

const description = Astro.props.description ?? `${t.home.heroLine1} · ${t.home.heroLine2}`;

const photographerLabel: Record<Lang, string> = {
  en: 'Photographer',
  fr: 'Photographe',
  it: 'Fotografa',
  pt: 'Fotógrafa',
};

const ogLocale: Record<Lang, string> = {
  en: 'en_US',
  fr: 'fr_FR',
  it: 'it_IT',
  pt: 'pt_BR',
};

const SITE_URL = "https://lauriedifrancesco.art";

const jobTitleMap: Record<Lang, string> = {
  en: 'Photographer and author',
  fr: 'Photographe et autrice',
  it: 'Fotografa e autrice',
  pt: 'Fotógrafa e autora',
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Laurie Di Francesco",
  "jobTitle": jobTitleMap[validLang],
  "url": SITE_URL,
  "sameAs": ["https://www.instagram.com/laurie.difrancesco/"],
  "knowsLanguage": ["fr", "en", "it", "pt"],
};
const siteTitle = title === "Home"
  ? `Laurie Di Francesco · ${photographerLabel[validLang]}`
  : title.includes("Laurie Di Francesco")
    ? title
    : `${title} · Laurie Di Francesco`;
const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = image.startsWith("http") ? image : `${SITE_URL}${image}`;

// Hreflang — strip lang prefix to get the base path common to all variants
const pathname = Astro.url.pathname;
const hreflangBase = validLang !== 'en'
  ? (pathname.replace(/^\/(fr|it|pt)/, '') || '/')
  : pathname;
const hreflangURL = (l: string) =>
  l === 'en' ? `${SITE_URL}${hreflangBase}` : `${SITE_URL}/${l}${hreflangBase}`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[validLang]} />
    <meta property="og:site_name" content="Laurie Di Francesco" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {hasTranslations && (
      <>
        <link rel="alternate" hreflang="en" href={hreflangURL('en')} />
        <link rel="alternate" hreflang="fr" href={hreflangURL('fr')} />
        <link rel="alternate" hreflang="it" href={hreflangURL('it')} />
        <link rel="alternate" hreflang="pt-BR" href={hreflangURL('pt')} />
        <link rel="alternate" hreflang="x-default" href={hreflangURL('en')} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <title>{siteTitle}</title>
    <Fragment set:html={`<script type="application/ld+json">${JSON.stringify(personSchema)}</script>`} />
    {jsonLd && <Fragment set:html={`<script type="application/ld+json">${JSON.stringify(jsonLd)}</script>`} />}
  </head>
  <body class={bodyClass}>
    <Header lightHeader={lightHeader} />
    <main>
      <slot />
    </main>
    <Footer />
    <Lightbox />
  </body>
</html>
